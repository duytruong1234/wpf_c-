<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="QuanLyKhoNguyenLieuPizza.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:QuanLyKhoNguyenLieuPizza.Views.Components"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:QuanLyKhoNguyenLieuPizza.ViewModels"
             xmlns:converters="clr-namespace:QuanLyKhoNguyenLieuPizza.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200">

    <d:UserControl.DataContext>
        <vm:DashboardViewModel/>
    </d:UserControl.DataContext>

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Title Style -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <!-- Table Header Style -->
        <Style x:Key="TableHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Table Cell Style -->
        <Style x:Key="TableCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Row Hover Style -->
        <Style x:Key="RowHoverStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Main Content -->
    <Grid Background="#F1F5F9">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,24">

                <!-- ═══════════ HEADER BAR ═══════════ -->
                <Border Background="#1E293B" CornerRadius="12" Padding="24,16" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="DASHBOARD TỔNG HỢP - PIZZA INN" FontSize="18" FontWeight="Bold" 
                                   Foreground="White" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                Command="{Binding ExportReportCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="#334155" CornerRadius="8" Padding="16,8">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Print24" FontSize="14" Foreground="White"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Xuất Báo Cáo Cả Trang" FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#475569"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- ═══════════ CẢNH BÁO HẠN SỬ DỤNG (REAL-TIME) ═══════════ -->
                <Border Background="White" BorderBrush="#FDE68A" BorderThickness="1.5" CornerRadius="12" 
                        Padding="0" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.03"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#FFFBEB" CornerRadius="12,12,0,0" Padding="20,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="KHU VỰC CẢNH BÁO HẠN SỬ DỤNG (DỮ LIỆU THỜI GIAN THỰC)" 
                                           FontSize="13" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Table Header -->
                        <Border Grid.Row="1" Background="#FEF3C7" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MÃ PHIẾU NHẬP (LÔ)" Style="{StaticResource TableHeaderStyle}" Foreground="#92400E"/>
                                <TextBlock Grid.Column="1" Text="TÊN NGUYÊN LIỆU" Style="{StaticResource TableHeaderStyle}" Foreground="#92400E"/>
                                <TextBlock Grid.Column="2" Text="HẠN SỬ DỤNG" Style="{StaticResource TableHeaderStyle}" Foreground="#92400E" TextAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="SỐ LƯỢNG CÒN" Style="{StaticResource TableHeaderStyle}" Foreground="#92400E" TextAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="SỐ NGÀY CÒN LẠI" Style="{StaticResource TableHeaderStyle}" Foreground="#92400E" TextAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="TRẠNG THÁI LÔ FEFO" Style="{StaticResource TableHeaderStyle}" Foreground="#92400E" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Table Content -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                            <ItemsControl ItemsSource="{Binding CanhBaoHSDItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FEF3C7" BorderThickness="0,0,0,1" Padding="20,16" Style="{StaticResource RowHoverStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding MaPhieuNhap}" Style="{StaticResource TableCellStyle}" FontWeight="Medium"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TenNguyenLieu}" Style="{StaticResource TableCellStyle}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding HanSuDung, StringFormat={}{0:dd/MM/yyyy}}" Style="{StaticResource TableCellStyle}" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding SoLuongCon}" Style="{StaticResource TableCellStyle}" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="4" TextAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontSize" Value="13"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Foreground" Value="#EA580C"/>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding SoNgayConLai, Mode=OneWay}"/>
                                                    <Run Text=" ngày"/>
                                                </TextBlock>
                                                <!-- Status Badge -->
                                                <Border Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        CornerRadius="6" Padding="10,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TrangThai}" Value="Đã hết hạn">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TrangThai}" Value="Sắp hết hạn - Ưu tiên xuất">
                                                                    <Setter Property="Background" Value="#FFF7ED"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding TrangThai}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TrangThai}" Value="Đã hết hạn">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding TrangThai}" Value="Sắp hết hạn - Ưu tiên xuất">
                                                                        <Setter Property="Foreground" Value="#EA580C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <!-- Empty state -->
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanhBaoHSDItems.Count}" Value="0">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <TextBlock Text="✅ Không có nguyên liệu nào sắp hết hạn" Foreground="#059669" FontWeight="Medium"
                                                                       HorizontalAlignment="Center" Margin="0,20,0,20" FontSize="13"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ═══════════ BỘ LỌC KỲ BÁO CÁO ═══════════ -->
                <Border Background="White" CornerRadius="10" Padding="20,16" Margin="0,0,0,20"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="BỘ LỌC KỲ BÁO CÁO:" FontSize="12" FontWeight="Bold" Foreground="#475569"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <DatePicker SelectedDate="{Binding NgayBatDau, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="140" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="đến" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0"/>
                        <DatePicker SelectedDate="{Binding NgayKetThuc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="140" FontSize="13" VerticalAlignment="Center"/>
                        <Button Command="{Binding ApDungCommand}" Cursor="Hand" Margin="16,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="apDungBorder" Background="#10B981" CornerRadius="8" Padding="20,8">
                                        <TextBlock Text="Áp dụng" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="apDungBorder" Property="Background" Value="#059669"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Command="{Binding XoaLocCommand}" Cursor="Hand" Margin="8,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="xoaLocBorder" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16,7">
                                        <TextBlock Text="Xóa lọc" FontSize="12" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="xoaLocBorder" Property="Background" Value="#CBD5E1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ═══════════ SECTION 1: PHÂN TÍCH DOANH THU & CHI PHÍ NHẬP HÀNG ═══════════ -->
                <TextBlock Text="Phân Tích Doanh Thu &amp; Chi Phí Nhập Hàng" Style="{StaticResource SectionTitleStyle}" Margin="4,0,0,12"/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card: Tổng doanh thu bán hàng -->
                    <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5" 
                            CornerRadius="12" Padding="24,20">
                        <StackPanel>
                            <TextBlock Text="TỔNG DOANH THU BÁN HÀNG" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding TongDoanhThuBanHang, StringFormat='{}{0:N0} đ'}" 
                                       FontSize="28" FontWeight="Bold" Foreground="#1D4ED8"/>
                        </StackPanel>
                    </Border>

                    <!-- Card: Tổng chi phí nhập hàng -->
                    <Border Grid.Column="2" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.5"
                            CornerRadius="12" Padding="24,20">
                        <StackPanel>
                            <TextBlock Text="TỔNG CHI PHÍ NHẬP HÀNG" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding TongChiPhiNhapHang, StringFormat='{}{0:N0} đ'}" 
                                       FontSize="28" FontWeight="Bold" Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>

                    <!-- Card: Chênh lệch lợi nhuận -->
                    <Border Grid.Column="4" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1.5"
                            CornerRadius="12" Padding="24,20">
                        <StackPanel>
                            <TextBlock Text="CHÊNH LỆCH LỢI NHUẬN" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ChenhLechLoiNhuan, StringFormat='{}{0:N0} đ'}" 
                                       FontSize="28" FontWeight="Bold" Foreground="#059669"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════ SECTION 2: ĐỐI SOÁT TIÊU HAO NGUYÊN LIỆU ═══════════ -->
                <TextBlock Text="Đối Soát Tiêu Hao Nguyên Liệu" Style="{StaticResource SectionTitleStyle}" Margin="4,0,0,12"/>
                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Table Header -->
                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="12,12,0,0" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MÃ NL" Style="{StaticResource TableHeaderStyle}"/>
                                <TextBlock Grid.Column="1" Text="TÊN NGUYÊN LIỆU" Style="{StaticResource TableHeaderStyle}"/>
                                <TextBlock Grid.Column="2" Text="ĐV CHUẨN" Style="{StaticResource TableHeaderStyle}" TextAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="TỔNG LƯỢNG NHẬP" Style="{StaticResource TableHeaderStyle}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="TỔNG LƯỢNG TIÊU HAO (PHIẾU XUẤT + BOM)" Style="{StaticResource TableHeaderStyle}" TextAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Table Content -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                            <ItemsControl ItemsSource="{Binding DoiSoatItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,16" Style="{StaticResource RowHoverStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding MaNL}" Style="{StaticResource TableCellStyle}" FontWeight="Medium"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TenNguyenLieu}" Style="{StaticResource TableCellStyle}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DonVi}" Style="{StaticResource TableCellStyle}" TextAlignment="Center" Foreground="#64748B"/>
                                                <TextBlock Grid.Column="3" Text="{Binding TongLuongNhap, StringFormat=N1}" Style="{StaticResource TableCellStyle}" TextAlignment="Right" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="4" Text="{Binding TongLuongTieuHao, StringFormat=N1}" Style="{StaticResource TableCellStyle}" TextAlignment="Right" FontWeight="SemiBold" Foreground="#7C3AED"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DoiSoatItems.Count}" Value="0">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <TextBlock Text="Chưa có dữ liệu đối soát trong kỳ báo cáo này" Foreground="#94A3B8" FontStyle="Italic"
                                                                       HorizontalAlignment="Center" Margin="0,30,0,30" FontSize="13"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ═══════════ SECTION 3: BIẾN ĐỘNG HAO HỤT SAU KIỂM KÊ VẬT LÝ ═══════════ -->
                <TextBlock Text="Biến Động Hao Hụt Sau Kiểm Kê Vật Lý" Style="{StaticResource SectionTitleStyle}" Margin="4,0,0,12"/>
                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Table Header -->
                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="12,12,0,0" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="NGÀY KIỂM KÊ" Style="{StaticResource TableHeaderStyle}"/>
                                <TextBlock Grid.Column="1" Text="MÃ NL" Style="{StaticResource TableHeaderStyle}"/>
                                <TextBlock Grid.Column="2" Text="TỒN HỆ THỐNG" Style="{StaticResource TableHeaderStyle}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="TỒN THỰC TẾ (ĐẾM TAY)" Style="{StaticResource TableHeaderStyle}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="CHÊNH LỆCH" Style="{StaticResource TableHeaderStyle}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="CHỨNG TỪ ĐIỀU CHỈNH" Style="{StaticResource TableHeaderStyle}" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Table Content -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                            <ItemsControl ItemsSource="{Binding BienDongItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,16" Style="{StaticResource RowHoverStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding NgayKiem, StringFormat={}{0:dd/MM/yyyy}}" Style="{StaticResource TableCellStyle}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding MaNL}" Style="{StaticResource TableCellStyle}" FontWeight="Medium"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TonHeThong, StringFormat=N1}" Style="{StaticResource TableCellStyle}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding TonThucTe, StringFormat=N1}" Style="{StaticResource TableCellStyle}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="{Binding ChenhLechDisplay}" TextAlignment="Right" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#6B7280"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ChenhLechColor}" Value="#DC2626">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ChenhLechColor}" Value="#10B981">
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Chứng từ badge -->
                                                <Border Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        CornerRadius="6" Padding="10,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ChungTuColor}" Value="#DC2626">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ChungTuColor}" Value="#2563EB">
                                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding ChungTuDisplay}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ChungTuColor}" Value="#DC2626">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ChungTuColor}" Value="#2563EB">
                                                                        <Setter Property="Foreground" Value="#2563EB"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BienDongItems.Count}" Value="0">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <TextBlock Text="Chưa có biến động hao hụt trong kỳ báo cáo này" Foreground="#94A3B8" FontStyle="Italic"
                                                                       HorizontalAlignment="Center" Margin="0,30,0,30" FontSize="13"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ═══════════ SECTION 4: XẾP HẠNG MÓN ĂN BÁN CHẠY NHẤT (POS) ═══════════ -->
                <TextBlock Text="Xếp Hạng Món Ăn Bán Chạy Nhất (POS)" Style="{StaticResource SectionTitleStyle}" Margin="4,0,0,12"/>
                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Table Header -->
                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="12,12,0,0" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MÃ MÓN" Style="{StaticResource TableHeaderStyle}"/>
                                <TextBlock Grid.Column="1" Text="TÊN MÓN ĂN" Style="{StaticResource TableHeaderStyle}"/>
                                <TextBlock Grid.Column="2" Text="SL ĐÃ BÁN" Style="{StaticResource TableHeaderStyle}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="DOANH THU MANG LẠI" Style="{StaticResource TableHeaderStyle}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="TỶ TRỌNG DOANH THU" Style="{StaticResource TableHeaderStyle}" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Table Content -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="400">
                            <ItemsControl ItemsSource="{Binding TopMonAnItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,16" Style="{StaticResource RowHoverStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding MaMon}" Style="{StaticResource TableCellStyle}" FontWeight="Medium"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TenMon}" Style="{StaticResource TableCellStyle}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SoLuongBan}" Style="{StaticResource TableCellStyle}" TextAlignment="Right" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DoanhThu, StringFormat='{}{0:N0} đ'}" Style="{StaticResource TableCellStyle}" TextAlignment="Right" FontWeight="SemiBold"/>
                                                <!-- Progress bar + percentage -->
                                                <Grid Grid.Column="4" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Height="8" CornerRadius="4" Background="#E2E8F0" VerticalAlignment="Center">
                                                        <Border Height="8" CornerRadius="4" HorizontalAlignment="Left"
                                                                Width="{Binding TyTrong, Converter={x:Static converters:PercentToWidthConverter.Instance}}">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                                                    <GradientStop Color="#1D4ED8" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding TyTrong, StringFormat='{}{0:F1}%'}" FontSize="11" FontWeight="Bold" 
                                                               Foreground="#1E40AF" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40" TextAlignment="Right"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopMonAnItems.Count}" Value="0">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <TextBlock Text="Chưa có dữ liệu bán hàng trong kỳ báo cáo này" Foreground="#94A3B8" FontStyle="Italic"
                                                                       HorizontalAlignment="Center" Margin="0,30,0,30" FontSize="13"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <!-- Loading Overlay -->
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Panel.ZIndex="999">
            <Border Background="Transparent" />
            <components:LoadingSpinner HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
