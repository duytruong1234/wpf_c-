<UserControl x:Class="QuanLyKhoNguyenLieuPizza.Views.TieuHaoDuBaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:QuanLyKhoNguyenLieuPizza.ViewModels"
             xmlns:converters="clr-namespace:QuanLyKhoNguyenLieuPizza.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:QuanLyKhoNguyenLieuPizza.Views.Components"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280"
             Background="#F1F5F9"
             FontFamily="Segoe UI Variable, Segoe UI, Arial">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <!-- Borderless ComboBox inside Pill Filter -->
        <Style x:Key="InnerPillComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton x:Name="ToggleButton"
                                          Grid.ColumnSpan="2"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="2,1">
                                            <ui:SymbolIcon Symbol="ChevronDown24"
                                                           FontSize="12"
                                                           Foreground="#334155"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="8,1,0,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="0,0,22,0"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   HorizontalOffset="-16"
                                   VerticalOffset="6"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="White"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Margin="8"
                                        Padding="5"
                                        MinWidth="220"
                                        MaxHeight="340">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.12"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="12,7"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="Medium"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                                            <Setter Property="Foreground" Value="#2563EB"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#DBEAFE"/>
                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Bordered Box ComboBox Style (for Analysis Ingredient & Backtest Month Pickers) -->
        <Style x:Key="BoxedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="BoxBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <ToggleButton Grid.ColumnSpan="2"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="10,5">
                                            <ui:SymbolIcon Symbol="ChevronDown24"
                                                           FontSize="12"
                                                           Foreground="#334155"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="12,6,28,6"/>
                            <Popup Placement="Bottom"
                                   VerticalOffset="4"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="White"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="6"
                                        Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="320">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.12"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="FontWeight" Value="Medium"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                                            <Setter Property="Foreground" Value="#0284C7"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#E0F2FE"/>
                                            <Setter Property="Foreground" Value="#0369A1"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dish Count Pill Button Style (02 món) -->
        <Style x:Key="DishCountPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#E0F2FE"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Solid Blue Action Button -->
        <Style x:Key="PrimaryBlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#0369A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Chọn làm chính" Outlined Button -->
        <Style x:Key="SelectModelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="114"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#FAF5FF"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#A855F7"/>
                                <Setter Property="Foreground" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- =========================================================================== -->
        <!-- SCREEN 1: GIAO DIỆN CHÍNH BẢNG TỔNG QUAN TIÊU HAO & DỰ BÁO (IMAGE 1)       -->
        <!-- =========================================================================== -->
        <Grid Margin="18,14,18,16"
              Visibility="{Binding IsOverviewMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. TOP FILTER BAR -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,11"
                    Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Pill Filters -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- THÁNG BÁO CÁO -->
                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="15,6"
                                Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="THÁNG BÁO CÁO:"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding KyOptions}"
                                          SelectedItem="{Binding SelectedKyOption}"
                                          DisplayMemberPath="DisplayText"
                                          Style="{StaticResource InnerPillComboBoxStyle}"
                                          MinWidth="118"/>
                            </StackPanel>
                        </Border>

                        <!-- NGUYÊN LIỆU -->
                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="15,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="NGUYÊN LIỆU:"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding NguyenLieuOptions}"
                                          SelectedItem="{Binding SelectedOverviewNguyenLieuOption}"
                                          DisplayMemberPath="DisplayText"
                                          Style="{StaticResource InnerPillComboBoxStyle}"
                                          MinWidth="220"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Button: Biểu đồ phân tích -->
                    <Button Grid.Column="2"
                            Command="{Binding OpenAnalysisViewCommand}"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr"
                                        Background="#E0F2FE"
                                        BorderBrush="#BAE6FD"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Padding="16,7">
                                    <TextBlock Text="Biểu đồ phân tích"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#0369A1"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#BAE6FD"/>
                                        <Setter TargetName="bdr" Property="BorderBrush" Value="#7DD3FC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. MAIN REPORT TABLE CARD -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Card Header -->
                    <Border Grid.Row="0"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            Padding="18,13">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="15" VerticalAlignment="Center">
                                    <Run Text="Báo Cáo Tiêu Hao Nguyên Liệu - " FontWeight="Bold" Foreground="#0F172A"/>
                                    <Run Text="{Binding ReportMonthHighlightText, Mode=OneWay}" FontWeight="Bold" Foreground="#0284C7"/>
                                </TextBlock>
                            </StackPanel>

                            <Border HorizontalAlignment="Right"
                                    Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalIngredientsCountText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#0284C7"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Table Column Headers -->
                    <Border Grid.Row="1"
                            Background="#FAF5FF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1">
                        <Grid Width="{Binding ActualWidth, ElementName=OverviewItemsControl}"
                              HorizontalAlignment="Left"
                              Background="#F8FAFC">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="1.85*"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="1.45*"/>
                                <ColumnDefinition Width="1.45*"/>
                                <ColumnDefinition Width="205"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="STT" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,11,0,11"/>
                            <TextBlock Grid.Column="1" Text="MÃ NL" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,11,0,11"/>
                            <TextBlock Grid.Column="2" Text="TÊN NGUYÊN LIỆU" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,11,0,11"/>
                            <TextBlock Grid.Column="3" Text="MÓN ĂN ĐÃ BÁN" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,11"/>
                            <TextBlock Grid.Column="4" Text="TỔNG TIÊU HAO" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,11"/>
                            <TextBlock Grid.Column="5" Text="{Binding PrevMonthHeaderText}" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,11"/>
                            <TextBlock Grid.Column="6" Text="{Binding PrevYearHeaderText}" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,11,16,11"/>

                            <!-- Purple Forecast Column Header -->
                            <Border Grid.Column="7"
                                    Background="#FAF5FF"
                                    BorderBrush="#F3E8FF"
                                    BorderThickness="1,0,0,0"
                                    Padding="12,11,18,11">
                                <TextBlock Text="{Binding NextForecastHeaderText}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#9333EA"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Table Body Rows -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="OverviewItemsControl" ItemsSource="{Binding TieuHaoItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RowBorder"
                                            Background="White"
                                            BorderBrush="#F1F5F9"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="78"/>
                                                <ColumnDefinition Width="1.85*"/>
                                                <ColumnDefinition Width="125"/>
                                                <ColumnDefinition Width="125"/>
                                                <ColumnDefinition Width="1.45*"/>
                                                <ColumnDefinition Width="1.45*"/>
                                                <ColumnDefinition Width="205"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- STT -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding STT}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#334155"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="14,12,0,12"/>

                                            <!-- Mã NL -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding MaNguyenLieu}"
                                                       FontSize="12.5"
                                                       FontWeight="Bold"
                                                       Foreground="#0F172A"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Margin="4,12,0,12"/>

                                            <!-- Tên Nguyên Liệu (Clickable -> Biểu đồ phân tích) -->
                                            <Button Grid.Column="2"
                                                    Style="{x:Null}"
                                                    Command="{Binding DataContext.SelectSingleIngredientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Nhấn để xem biểu đồ phân tích chi tiết"
                                                    Cursor="Hand"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Margin="6,12,10,12">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                                            <TextBlock x:Name="NameText"
                                                                       Text="{Binding TenNguyenLieu}"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       Foreground="#0F172A"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="NameText" Property="Foreground" Value="#0284C7"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Món ăn đã bán -->
                                            <Button Grid.Column="3"
                                                    Style="{StaticResource DishCountPillButtonStyle}"
                                                    Command="{Binding DataContext.OpenDishPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SoMonAnText}" VerticalAlignment="Center"/>
                                            </Button>

                                            <!-- Tổng tiêu hao -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding TongTieuHaoText}"
                                                       FontSize="13.5"
                                                       FontWeight="Bold"
                                                       Foreground="#0284C7"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>

                                            <!-- So với tháng trước -->
                                            <TextBlock x:Name="PrevMonthText"
                                                       Grid.Column="5"
                                                       FontSize="12.5"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding PrevMonthDiffText, Mode=OneWay}" FontWeight="Bold"/>
                                                <Run Text="{Binding PrevMonthPctText, Mode=OneWay}" FontWeight="Normal" FontSize="11.5"/>
                                            </TextBlock>

                                            <!-- So với cùng kỳ năm trước -->
                                            <TextBlock x:Name="PrevYearText"
                                                       Grid.Column="6"
                                                       FontSize="12.5"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,16,0">
                                                <Run Text="{Binding PrevYearDiffText, Mode=OneWay}" FontWeight="Bold"/>
                                                <Run Text="{Binding PrevYearPctText, Mode=OneWay}" FontWeight="Normal" FontSize="11.5"/>
                                            </TextBlock>

                                            <!-- Cột Dự Báo (Tháng kế tiếp) — Full-width & Uniform -->
                                            <Button Grid.Column="7"
                                                    Style="{x:Null}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.OpenIngredientForecastCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Nhấn để mở chi tiết Dự báo tiêu hao và đề xuất nhập kho"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ForecastCellBg"
                                                                Background="#FAF5FF"
                                                                BorderBrush="#F3E8FF"
                                                                BorderThickness="1,0,0,0"
                                                                Padding="12,9,18,9">
                                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <Border Background="White"
                                                                        BorderBrush="#E9D5FF"
                                                                        BorderThickness="1"
                                                                        CornerRadius="5"
                                                                        MinWidth="122"
                                                                        Padding="8,2"
                                                                        HorizontalAlignment="Right"
                                                                        Margin="0,0,0,4">
                                                                    <TextBlock Text="{Binding DuBaoTenPhuongPhapBadge}"
                                                                               FontSize="10.5"
                                                                               FontWeight="Bold"
                                                                               Foreground="#7C3AED"
                                                                               HorizontalAlignment="Center"
                                                                               TextAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding DuBaoKyToiText}"
                                                                           FontSize="13.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="#0369A1"
                                                                           HorizontalAlignment="Right"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ForecastCellBg" Property="Background" Value="#F3E8FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#F8FAFC"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding PrevMonthTrend}" Value="1">
                                            <Setter TargetName="PrevMonthText" Property="Foreground" Value="#16A34A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PrevMonthTrend}" Value="-1">
                                            <Setter TargetName="PrevMonthText" Property="Foreground" Value="#DC2626"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PrevYearTrend}" Value="1">
                                            <Setter TargetName="PrevYearText" Property="Foreground" Value="#16A34A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PrevYearTrend}" Value="-1">
                                            <Setter TargetName="PrevYearText" Property="Foreground" Value="#DC2626"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- =========================================================================== -->
        <!-- SCREEN 2: BIỂU ĐỒ PHÂN TÍCH & DỰ BÁO CHI TIẾT NGUYÊN LIỆU (IMAGE 2..5)      -->
        <!-- =========================================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsAnalysisMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Margin="18,14,18,22">

                <!-- 1. Back Button: Quay Lại Bảng Tổng Quan -->
                <Button Command="{Binding BackToOverviewCommand}"
                        HorizontalAlignment="Left"
                        Cursor="Hand"
                        Margin="0,0,0,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bdr"
                                    Background="White"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="13,6">
                                <TextBlock Text="← Quay Lại Bảng Tổng Quan"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#1E293B"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdr" Property="Background" Value="#F8FAFC"/>
                                    <Setter TargetName="bdr" Property="BorderBrush" Value="#94A3B8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 2. Ingredient Selector & Refresh Card -->
                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20,14"
                        Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03"/>
                    </Border.Effect>

                    <Grid>
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="NGUYÊN LIỆU PHÂN TÍCH:"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="#64748B"
                                       Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AnalysisNguyenLieuOptions}"
                                      SelectedItem="{Binding SelectedAnalysisNguyenLieu}"
                                      DisplayMemberPath="DisplayText"
                                      Style="{StaticResource BoxedComboBoxStyle}"
                                      MinWidth="295"/>
                        </StackPanel>

                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{Binding RefreshAnalysisCommand}"
                                Style="{StaticResource PrimaryBlueButtonStyle}"
                                Content="Làm mới dữ liệu"/>
                    </Grid>
                </Border>

                <!-- 3. Segmented Sub-Tab Switcher ("Phân tích tiêu hao" | "Dự báo tiêu hao và đề xuất nhập kho") -->
                <Border Background="#E2E8F0"
                        CornerRadius="8"
                        Padding="4"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <!-- Tab 1 Button -->
                        <Button Command="{Binding SwitchToConsumptionTabCommand}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TabBdr"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="16,7">
                                        <TextBlock x:Name="TabTxt"
                                                   Text="Phân tích tiêu hao"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Foreground="#334155"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsConsumptionTab}" Value="True">
                                            <Setter TargetName="TabBdr" Property="Background" Value="White"/>
                                            <Setter TargetName="TabTxt" Property="Foreground" Value="#0284C7"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Tab 2 Button -->
                        <Button Command="{Binding SwitchToForecastTabCommand}" Cursor="Hand" Margin="4,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TabBdr"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="16,7">
                                        <TextBlock x:Name="TabTxt"
                                                   Text="Dự báo tiêu hao và đề xuất nhập kho"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Foreground="#334155"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsForecastTab}" Value="True">
                                            <Setter TargetName="TabBdr" Property="Background" Value="White"/>
                                            <Setter TargetName="TabTxt" Property="Foreground" Value="#0284C7"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- =================================================================== -->
                <!-- TAB 1 CONTENT: PHÂN TÍCH TIÊU HAO (IMAGE 2)                         -->
                <!-- =================================================================== -->
                <StackPanel Visibility="{Binding IsConsumptionTab, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Card 1: Lượng Tiêu Hao 12 Tháng + 2x2 KPI Cards -->
                    <Border Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="22,16"
                            Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>

                        <StackPanel>
                            <!-- Card Header + NĂM PHÂN TÍCH -->
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="{Binding BarChartHeaderTitle}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center"/>

                                <Border HorizontalAlignment="Right"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="NĂM PHÂN TÍCH:"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding NamOptions}"
                                                  SelectedItem="{Binding SelectedNamOption}"
                                                  DisplayMemberPath="DisplayText"
                                                  Style="{StaticResource BoxedComboBoxStyle}"
                                                  MinWidth="105"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Left: 12-Month Bar Chart | Right: 2x2 KPI Summary Cards -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.55*"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="1.05*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: 12-Month Bar Chart -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 9 Y-Axis Ticks (8 intervals * 26px = 208px) -->
                                        <ItemsControl Grid.Column="0"
                                                      Grid.ColumnSpan="2"
                                                      ItemsSource="{Binding YAxisTicks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="26">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="58"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Label}"
                                                                   FontSize="10.5"
                                                                   Foreground="#64748B"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                                        <Border Grid.Column="1"
                                                                Height="1"
                                                                Background="#E2E8F0"
                                                                VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Plot Canvas (exact 208px height) -->
                                        <Grid Grid.Column="1"
                                              Height="208"
                                              VerticalAlignment="Center">
                                            <Border Width="1" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="#CBD5E1"/>

                                            <!-- Dashed Average Line -->
                                            <Line X1="0" Y1="0" X2="1" Y2="0"
                                                  Stretch="Fill"
                                                  Stroke="#0284C7"
                                                  StrokeThickness="1.4"
                                                  StrokeDashArray="3,3"
                                                  VerticalAlignment="Bottom"
                                                  Margin="{Binding AvgLineMargin}"
                                                  Panel.ZIndex="1"/>

                                            <!-- 12 Bars -->
                                            <ItemsControl ItemsSource="{Binding SeasonThangItems}" Panel.ZIndex="2">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" Columns="12"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                            <Border x:Name="BarRect"
                                                                    Width="28"
                                                                    Height="{Binding BarHeight}"
                                                                    Background="#29B6F6"
                                                                    CornerRadius="2,2,0,0"
                                                                    ToolTip="{Binding ToolTipText}"
                                                                    Visibility="{Binding HasData, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                    Cursor="Hand"/>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsMax}" Value="True">
                                                                <Setter TargetName="BarRect" Property="Background" Value="#7C3AED"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMin}" Value="True">
                                                                <Setter TargetName="BarRect" Property="Background" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Grid>

                                    <!-- X-Axis Labels (T01..T12) -->
                                    <Grid Grid.Row="1" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding SeasonThangItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" Columns="12"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ThangLabel}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#475569"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>

                                <!-- Right Column: 2x2 KPI Cards -->
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Top-Left: Tổng tiêu hao trong năm -->
                                    <Border Grid.Row="0" Grid.Column="0"
                                            Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,16">
                                        <StackPanel>
                                            <TextBlock Text="TỔNG TIÊU HAO TRONG NĂM" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding SeasonTotalValueText}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Top-Right: Trung bình mỗi tháng -->
                                    <Border Grid.Row="0" Grid.Column="2"
                                            Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,16">
                                        <StackPanel>
                                            <TextBlock Text="TRUNG BÌNH MỖI THÁNG" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding SeasonAvgValueText}" FontSize="22" FontWeight="Bold" Foreground="#0284C7" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Bottom-Left: Tháng cao nhất -->
                                    <Border Grid.Row="2" Grid.Column="0"
                                            Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,16"
                                            ToolTip="{Binding SeasonMaxSubText}">
                                        <StackPanel>
                                            <TextBlock Text="THÁNG CAO NHẤT" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding SeasonMaxValueText}" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Bottom-Right: Tháng thấp nhất -->
                                    <Border Grid.Row="2" Grid.Column="2"
                                            Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,16"
                                            ToolTip="{Binding SeasonMinSubText}">
                                        <StackPanel>
                                            <TextBlock Text="THÁNG THẤP NHẤT" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding SeasonMinValueText}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: So Sánh Chuỗi Tiêu Hao Giữa Các Năm (Biểu đồ đường + Bảng thống kê) -->
                    <Border Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="22,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>

                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="So Sánh Chuỗi Tiêu Hao Giữa Các Năm"
                                           FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <ItemsControl ItemsSource="{Binding YearSeries}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                      Margin="14,0,0,0" VerticalAlignment="Center" Cursor="Hand">
                                                <TextBlock Text="{Binding NamLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- Centered Legend -->
                            <ItemsControl ItemsSource="{Binding YearSeries}" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel x:Name="LegendItem" Orientation="Horizontal" Margin="8,0">
                                            <Border Width="11" Height="11" CornerRadius="2" Background="{Binding LineBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding NamLabel}" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                <Setter TargetName="LegendItem" Property="Opacity" Value="0.35"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <components:MultiLineChart Series="{Binding YearSeries}" Height="230" Margin="0,0,0,16"/>

                            <TextBlock Text="Bảng Thống Kê Số Liệu Tiêu Hao Từng Tháng Qua Các Năm:"
                                       FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>

                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="NĂM KHẢO SÁT" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            <UniformGrid Grid.Column="1" Rows="1" Columns="12">
                                                <TextBlock Text="T01" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="T02" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="T03" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="T04" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="T05" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="T06" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="T07" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="T08" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="T09" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="T10" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="T11" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="T12" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            </UniformGrid>
                                            <TextBlock Grid.Column="2" Text="TỔNG CỘNG" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="TB/THÁNG" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding YearSeries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="90"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{Binding LineBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding NamLabel}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding ThangTexts}" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Rows="1" Columns="12"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Grid.Column="2" Text="{Binding TongText}" FontSize="12" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding TrungBinhText}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- =================================================================== -->
                <!-- TAB 2 CONTENT: DỰ BÁO TIÊU HAO VÀ ĐỀ XUẤT NHẬP KHO (IMAGE 3, 4, 5)  -->
                <!-- =================================================================== -->
                <StackPanel Visibility="{Binding IsForecastTab, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- CARD A: KẾ HOẠCH DỰ BÁO THÁNG TIẾP THEO (IMAGE 3 TOP) -->
                    <Border Background="White"
                            BorderBrush="#E9D5FF"
                            BorderThickness="1.2"
                            CornerRadius="12"
                            Padding="20,16"
                            Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="{Binding NextPlanHeaderTitle}"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="#7C3AED"
                                       Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- A1: Phương pháp dự báo được chọn -->
                                <Border Grid.Column="0" Background="#FAF5FF" BorderBrush="#F3E8FF" BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <Border Width="4" HorizontalAlignment="Left" Background="#8B5CF6" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="16,14" VerticalAlignment="Center">
                                            <TextBlock Text="PHƯƠNG PHÁP DỰ BÁO ĐƯỢC CHỌN" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding ActiveModelNameText}" FontSize="20" FontWeight="Bold" Foreground="#7C3AED" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- A2: Số lượng tiêu hao dự báo -->
                                <Border Grid.Column="2" Background="#FAF5FF" BorderBrush="#F3E8FF" BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <Border Width="4" HorizontalAlignment="Left" Background="#8B5CF6" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="16,14" VerticalAlignment="Center">
                                            <TextBlock Text="SỐ LƯỢNG TIÊU HAO DỰ BÁO" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding NextForecastQtyText}" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- A3: Tồn kho thực tế hiện có -->
                                <Border Grid.Column="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <Border Width="4" HorizontalAlignment="Left" Background="#0284C7" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="16,14" VerticalAlignment="Center">
                                            <TextBlock Text="TỒN KHO THỰC TẾ HIỆN CÓ" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding CurrentStockQtyText}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- A4: Đề xuất nhập kho tham khảo -->
                                <Border Grid.Column="6" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <Border Width="4" HorizontalAlignment="Left" Background="#DC2626" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="16,14" VerticalAlignment="Center">
                                            <TextBlock Text="ĐỀ XUẤT NHẬP KHO THAM KHẢO" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding SuggestedImportQtyText}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD B: KẾT QUẢ DỰ BÁO THÁNG VỪA RỒI (IMAGE 3 BOTTOM) -->
                    <Border Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20,16"
                            Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>

                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{Binding LastResultHeaderTitle}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center"/>

                                <!-- Button: Xem lịch sử dự báo -->
                                <Button HorizontalAlignment="Right"
                                        Command="{Binding OpenHistoryPopupCommand}"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdr"
                                                    Background="White"
                                                    BorderBrush="#DDD6FE"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="12,5">
                                                <TextBlock Text="Xem lịch sử dự báo" FontSize="12" FontWeight="Bold" Foreground="#7C3AED" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdr" Property="Background" Value="#FAF5FF"/>
                                                    <Setter TargetName="bdr" Property="BorderBrush" Value="#A855F7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- B1: Phương pháp dự báo -->
                                <Border Grid.Column="0" Background="#FAF5FF" BorderBrush="#F3E8FF" BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <Border Width="4" HorizontalAlignment="Left" Background="#7C3AED" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="15,14" VerticalAlignment="Center">
                                            <TextBlock Text="PHƯƠNG PHÁP DỰ BÁO" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding LastModelNameText}" FontSize="18.5" FontWeight="Bold" Foreground="#7C3AED" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- B2: Số lượng tiêu hao dự báo -->
                                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <Border Width="4" HorizontalAlignment="Left" Background="#0284C7" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="15,14" VerticalAlignment="Center">
                                            <TextBlock Text="SỐ LƯỢNG TIÊU HAO DỰ BÁO" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding LastForecastQtyText}" FontSize="21" FontWeight="Bold" Foreground="#0284C7" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- B3: Tiêu hao thực tế -->
                                <Border Grid.Column="4" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <Border Width="4" HorizontalAlignment="Left" Background="#DC2626" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="15,14" VerticalAlignment="Center">
                                            <TextBlock Text="TIÊU HAO THỰC TẾ" FontSize="10.5" FontWeight="Bold" Foreground="#DC2626"/>
                                            <TextBlock Text="{Binding LastActualQtyText}" FontSize="21" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- B4: Sai số lệch -->
                                <Border Grid.Column="6" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <Border Width="4" HorizontalAlignment="Left" Background="#64748B" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="15,12" VerticalAlignment="Center">
                                            <TextBlock Text="SAI SỐ LỆCH" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding LastAbsErrorText}" FontSize="21" FontWeight="Bold" Foreground="#0F172A" Margin="0,3,0,2"/>
                                            <TextBlock Text="|Thực tế - Dự báo|" FontSize="10.5" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- B5: APE (%) -->
                                <Border Grid.Column="8" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <Border Width="4" HorizontalAlignment="Left" Background="#16A34A" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="15,12" VerticalAlignment="Center">
                                            <TextBlock Text="APE (%)" FontSize="10.5" FontWeight="Bold" Foreground="#16A34A"/>
                                            <TextBlock Text="{Binding LastApeText}" FontSize="21" FontWeight="Bold" Foreground="#16A34A" Margin="0,3,0,2"/>
                                            <TextBlock Text="{Binding LastConfidenceText}" FontSize="10.5" FontWeight="Bold" Foreground="#15803D"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD C: KIỂM THỬ THỰC NGHIỆM + BIỂU ĐỒ ĐỐI CHIẾU + BẢNG CHI TIẾT 5 MÔ HÌNH (IMAGE 4 & 5) -->
                    <Border Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20,18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>

                        <StackPanel>
                            <!-- 1. Train & Test Range Picker Strip -->
                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,10"
                                    Margin="0,0,0,18">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Kỳ huấn luyện -->
                                        <TextBlock Text="KỲ HUẤN LUYỆN:" FontSize="12" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Từ" FontSize="12" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox ItemsSource="{Binding BacktestKyOptions}"
                                                  SelectedItem="{Binding SelectedTrainStartKy}"
                                                  DisplayMemberPath="DisplayMMYYYY"
                                                  Style="{StaticResource BoxedComboBoxStyle}"
                                                  MinWidth="96"/>
                                        <TextBlock Text="Đến" FontSize="12" Foreground="#334155" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                        <ComboBox ItemsSource="{Binding BacktestKyOptions}"
                                                  SelectedItem="{Binding SelectedTrainEndKy}"
                                                  DisplayMemberPath="DisplayMMYYYY"
                                                  Style="{StaticResource BoxedComboBoxStyle}"
                                                  MinWidth="96"/>
                                        <TextBlock Text="{Binding TrainCountLabelText}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,16,0"/>

                                        <Border Width="1" Height="20" Background="#CBD5E1" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                        <!-- Kỳ kiểm thử -->
                                        <TextBlock Text="KỲ KIỂM THỬ:" FontSize="12" FontWeight="Bold" Foreground="#7C3AED" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Từ" FontSize="12" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox ItemsSource="{Binding BacktestKyOptions}"
                                                  SelectedItem="{Binding SelectedTestStartKy}"
                                                  DisplayMemberPath="DisplayMMYYYY"
                                                  Style="{StaticResource BoxedComboBoxStyle}"
                                                  MinWidth="96"/>
                                        <TextBlock Text="Đến" FontSize="12" Foreground="#334155" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                        <ComboBox ItemsSource="{Binding BacktestKyOptions}"
                                                  SelectedItem="{Binding SelectedTestEndKy}"
                                                  DisplayMemberPath="DisplayMMYYYY"
                                                  Style="{StaticResource BoxedComboBoxStyle}"
                                                  MinWidth="96"/>
                                        <TextBlock Text="{Binding TestCountLabelText}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Command="{Binding RunBacktestCommand}"
                                            Style="{StaticResource PrimaryBlueButtonStyle}"
                                            Content="Chạy lại kiểm thử"/>
                                </Grid>
                            </Border>

                            <!-- 2. Multi-Model Comparison Line Chart -->
                            <TextBlock Text="{Binding ComparisonChartTitle}"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,10"/>

                            <!-- Interactive Legend -->
                            <ItemsControl ItemsSource="{Binding ForecastChartSeriesList}"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ToggleSeriesVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Margin="8,2"
                                                ToolTip="Nhấn để ẩn/hiện đường biểu diễn này">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <StackPanel x:Name="LegPanel" Orientation="Horizontal" Background="Transparent">
                                                        <!-- Solid Box for Actual & Active Model -->
                                                        <Border x:Name="SolidBox"
                                                                Width="13" Height="13"
                                                                Background="{Binding LineBrush}"
                                                                CornerRadius="2"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,6,0"/>
                                                        <!-- Dashed Box for Secondary Models -->
                                                        <Grid x:Name="DashedBox"
                                                              Width="13" Height="13"
                                                              Visibility="Collapsed"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,6,0">
                                                            <Rectangle Fill="#F1F5F9"
                                                                       Stroke="{Binding LineBrush}"
                                                                       StrokeThickness="1.4"
                                                                       StrokeDashArray="2,1.5"
                                                                       RadiusX="2" RadiusY="2"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#334155"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsDashed}" Value="True">
                                                            <Setter TargetName="SolidBox" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="DashedBox" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                            <Setter TargetName="LegPanel" Property="Opacity" Value="0.35"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <components:ForecastComparisonChart Series="{Binding ForecastChartSeriesList}"
                                                                Height="275"
                                                                Margin="0,0,0,22"/>

                            <Border Height="1" Background="#E2E8F0" Margin="0,0,0,18"/>

                            <!-- 3. Detailed Model Comparison Table (IMAGE 5) -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="BẢNG THÔNG TIN CHI TIẾT VÀ CHÊNH LỆCH TỪNG DỰ BÁO SO VỚI THỰC TẾ"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"/>
                                    <TextBlock FontSize="12" Foreground="#64748B" Margin="0,3,0,0">
                                        <Run Text="Mỗi ô dự báo thể hiện: "/>
                                        <Run Text="Số dự báo" FontWeight="Bold" Foreground="#334155"/>
                                        <Run Text=" bên trên và "/>
                                        <Run Text="Độ chênh lệch so với thực tế" FontWeight="Bold" Foreground="#334155"/>
                                        <Run Text=" bên dưới"/>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Text="{Binding ForecastUnitLabelText}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#475569"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"/>
                            </Grid>

                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <StackPanel>
                                    <!-- Table Header Row -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="8,10">
                                                <TextBlock Text="THÁNG" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="#FFF5F5" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="12,10">
                                                <TextBlock Text="TIÊU HAO THỰC TẾ" FontSize="11" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right"/>
                                            </Border>

                                            <!-- WMA Header -->
                                            <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="12,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWmaActive}" Value="True">
                                                                <Setter Property="Background" Value="#FAF5FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="WMA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWmaActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#7C3AED"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- SES Header -->
                                            <Border Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="12,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSesActive}" Value="True">
                                                                <Setter Property="Background" Value="#FAF5FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="SES" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSesActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#7C3AED"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- HOLT Header -->
                                            <Border Grid.Column="4" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="12,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHoltActive}" Value="True">
                                                                <Setter Property="Background" Value="#FAF5FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="HOLT" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHoltActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#7C3AED"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- HW ADDITIVE Header -->
                                            <Border Grid.Column="5" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="12,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHwAddActive}" Value="True">
                                                                <Setter Property="Background" Value="#FAF5FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="HW ADDITIVE" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHwAddActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#7C3AED"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- HW MULTIPLICATIVE Header -->
                                            <Border Grid.Column="6" Padding="12,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHwMulActive}" Value="True">
                                                                <Setter Property="Background" Value="#FAF5FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="HW MULTIPLICATIVE" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHwMulActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#7C3AED"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Monthly Backtest Rows -->
                                    <ItemsControl ItemsSource="{Binding BacktestRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="95"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Tháng -->
                                                        <Border Grid.Column="0" BorderBrush="#F1F5F9" BorderThickness="0,0,1,0" Padding="8,9">
                                                            <TextBlock Text="{Binding ThangText}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Tiêu hao thực tế -->
                                                        <Border Grid.Column="1" Background="#FFF5F5" BorderBrush="#F1F5F9" BorderThickness="0,0,1,0" Padding="12,9">
                                                            <TextBlock Text="{Binding ActualText}" FontSize="12.5" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- WMA Cell -->
                                                        <Border x:Name="WmaCell" Grid.Column="2" BorderBrush="#F1F5F9" BorderThickness="0,0,1,0" Padding="12,8">
                                                            <StackPanel HorizontalAlignment="Right">
                                                                <TextBlock x:Name="WmaVal" Text="{Binding Wma.ForecastText}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                                                <TextBlock x:Name="WmaDiff" Text="{Binding Wma.DiffPctText}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- SES Cell -->
                                                        <Border x:Name="SesCell" Grid.Column="3" BorderBrush="#F1F5F9" BorderThickness="0,0,1,0" Padding="12,8">
