                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- =========================================================================== -->
        <!-- MODAL POPUP 1: DANH SÁCH MÓN ĂN BÁN RA THEO NGUYÊN LIỆU                     -->
        <!-- =========================================================================== -->
        <Grid Background="#800F172A"
              Visibility="{Binding IsDishPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="100">
            <Border Background="White"
                    CornerRadius="14"
                    MaxWidth="900"
                    MaxHeight="580"
                    Margin="32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.25"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="22,16">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DishPopupTitle}" FontSize="16.5" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Dữ liệu bán hàng từ POS trong kỳ đã chọn" FontSize="12.5" Foreground="#64748B" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding CloseDishPopupCommand}" Cursor="Hand" Width="32" Height="32">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="closeBg" Background="#F1F5F9" CornerRadius="16">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="closeBg" Property="Background" Value="#FEE2E2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid Width="{Binding ActualWidth, ElementName=DishItemsControl}" HorizontalAlignment="Left" Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="67"/>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.45*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="STT" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Margin="22,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="TÊN MÓN ĂN BÁN RA" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="KÍCH CỠ (SIZE)" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="ĐỊNH MỨC BOM" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="SỐ LƯỢNG ĐÃ BÁN" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="TỔNG TIÊU HAO (KHO)" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,0,22,0"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DishItemsControl" ItemsSource="{Binding DishPopupItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="67"/>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="1.25*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.45*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding STT}" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22,0,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TenMonAn}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="6" Padding="10,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KichCoText}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding DinhMucBOMText}" FontSize="13" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding SoLuongDaBanText}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding TongTieuHaoKhoText}" FontSize="13.5" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14">
                        <Grid Width="{Binding ActualWidth, ElementName=DishItemsControl}" HorizontalAlignment="Left" Margin="0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="67"/>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.45*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Grid.ColumnSpan="4" Text="TỔNG CỘNG TIÊU HAO:" FontSize="13" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="4" Text="{Binding TotalSoldPortionsText}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="{Binding TotalConsumedPopupText}" FontSize="15" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- =========================================================================== -->
        <!-- MODAL POPUP 2: LỊCH SỬ DỰ BÁO TIÊU HAO NGUYÊN LIỆU (IMAGE 6)                -->
        <!-- =========================================================================== -->
        <Grid Background="#800F172A"
              Visibility="{Binding IsHistoryPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="110">
            <Border Background="White"
                    CornerRadius="14"
                    MaxWidth="940"
                    MaxHeight="600"
                    Margin="32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.25"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,18">
                        <Grid>
                            <TextBlock Text="{Binding HistoryPopupTitle}"
                                       FontSize="15.5"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center"/>

                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Command="{Binding CloseHistoryPopupCommand}"
                                    Cursor="Hand"
                                    Width="30"
                                    Height="30">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="closeBg" Background="Transparent" CornerRadius="15">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Modal Table Container -->
                    <Border Grid.Row="1"
                            Margin="24,18,24,24"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <Grid Width="{Binding ActualWidth, ElementName=HistoryItemsControl}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="1.0*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="8,11">
                                        <TextBlock Text="KỲ DỰ BÁO" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="8,11">
                                        <TextBlock Text="NGÀY THỰC HIỆN" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="14,11">
                                        <TextBlock Text="TÊN PHƯƠNG PHÁP" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Left"/>
                                    </Border>
                                    <Border Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="14,11">
                                        <TextBlock Text="TIÊU HAO DỰ BÁO" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right"/>
                                    </Border>
                                    <Border Grid.Column="4" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="14,11">
                                        <TextBlock Text="TIÊU HAO THỰC TẾ" FontSize="11" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right"/>
                                    </Border>
                                    <Border Grid.Column="5" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="14,11">
                                        <TextBlock Text="SAI SỐ LỆCH" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right"/>
                                    </Border>
                                    <Border Grid.Column="6" Padding="14,11">
                                        <TextBlock Text="APE (%)" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Rows -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="HistoryItemsControl" ItemsSource="{Binding HistoryItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="HistRow" Background="White" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="125"/>
                                                        <ColumnDefinition Width="1.4*"/>
                                                        <ColumnDefinition Width="1.15*"/>
                                                        <ColumnDefinition Width="1.15*"/>
                                                        <ColumnDefinition Width="1.0*"/>
                                                        <ColumnDefinition Width="0.9*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Kỳ dự báo + Status Badge -->
                                                    <Border Grid.Column="0" BorderBrush="#F1F5F9" BorderThickness="0,0,1,0" Padding="8,10">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock x:Name="KyTxt" Text="{Binding KyDuBaoText}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                                            <Border x:Name="StatusBdr"
                                                                    Background="#F0FDF4"
                                                                    BorderBrush="#BBF7D0"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    MinWidth="74"
                                                                    Padding="7,2"
                                                                    Margin="0,4,0,0"
                                                                    HorizontalAlignment="Center">
                                                                <TextBlock x:Name="StatusTxt"
                                                                           Text="{Binding StatusText}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="#16A34A"
                                                                           MaxWidth="72"
                                                                           TextWrapping="Wrap"
                                                                           TextAlignment="Center"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Ngày thực hiện -->
                                                    <Border Grid.Column="1" BorderBrush="#F1F5F9" BorderThickness="0,0,1,0" Padding="8,10">
                                                        <TextBlock x:Name="NgayTxt" Text="{Binding NgayThucHienText}" FontSize="12.5" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Tên phương pháp -->
                                                    <Border Grid.Column="2" BorderBrush="#F1F5F9" BorderThickness="0,0,1,0" Padding="14,10">
                                                        <TextBlock x:Name="PpTxt" Text="{Binding TenPhuongPhap}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Tiêu hao dự báo -->
                                                    <Border Grid.Column="3" BorderBrush="#F1F5F9" BorderThickness="0,0,1,0" Padding="14,10">
                                                        <TextBlock x:Name="DbTxt" Text="{Binding TieuHaoDuBaoText}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Tiêu hao thực tế -->
                                                    <Border Grid.Column="4" BorderBrush="#F1F5F9" BorderThickness="0,0,1,0" Padding="14,10">
                                                        <TextBlock x:Name="TtTxt" Text="{Binding TieuHaoThucTeText}" FontSize="13" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Sai số lệch -->
                                                    <Border Grid.Column="5" BorderBrush="#F1F5F9" BorderThickness="0,0,1,0" Padding="14,10">
                                                        <TextBlock x:Name="SsTxt" Text="{Binding SaiSoLechText}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- APE (%) -->
                                                    <Border Grid.Column="6" Padding="14,10">
                                                        <TextBlock x:Name="ApeTxt" Text="{Binding ApeText}" FontSize="13" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                    <Setter TargetName="HistRow" Property="Background" Value="#FAF5FF"/>
                                                    <Setter TargetName="KyTxt" Property="Foreground" Value="#7C3AED"/>
                                                    <Setter TargetName="StatusBdr" Property="Background" Value="#EFF6FF"/>
                                                    <Setter TargetName="StatusBdr" Property="BorderBrush" Value="#93C5FD"/>
                                                    <Setter TargetName="StatusTxt" Property="Foreground" Value="#2563EB"/>
                                                    <Setter TargetName="NgayTxt" Property="FontWeight" Value="Bold"/>
                                                    <Setter TargetName="NgayTxt" Property="Foreground" Value="#0F172A"/>
                                                    <Setter TargetName="PpTxt" Property="Foreground" Value="#7C3AED"/>
                                                    <Setter TargetName="DbTxt" Property="Foreground" Value="#7C3AED"/>
                                                    <Setter TargetName="TtTxt" Property="Foreground" Value="#94A3B8"/>
                                                    <Setter TargetName="SsTxt" Property="Foreground" Value="#94A3B8"/>
                                                    <Setter TargetName="ApeTxt" Property="Foreground" Value="#94A3B8"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
