<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="QuanLyKhoNguyenLieuPizza.Views.TonKhoView"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:vm="clr-namespace:QuanLyKhoNguyenLieuPizza.ViewModels"
         xmlns:converters="clr-namespace:QuanLyKhoNguyenLieuPizza.Converters"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         xmlns:behaviors="clr-namespace:QuanLyKhoNguyenLieuPizza.Behaviors"
         mc:Ignorable="d"
         d:DesignHeight="750" d:DesignWidth="1100">

<d:UserControl.DataContext>
    <vm:TonKhoViewModel/>
</d:UserControl.DataContext>

<UserControl.Resources>
    <!-- Bộ chuyển đổi -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    <converters:StringLengthToVisibilityConverter x:Key="StringLengthToVisibilityConverter"/>
    <converters:ImagePathConverter x:Key="ImagePathConverter"/>

    <!-- Gradient cho Tiêu đề Popup -->
    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E74C3C" Offset="0"/>
        <GradientStop Color="#F39C12" Offset="1"/>
    </LinearGradientBrush>

    <!-- Kiểu thẻ -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.05"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút Chính -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource DarkBlue}"/>
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#5B6AFF" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kiểu Nút Icon -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút Bộ lọc Thẻ -->
    <Style x:Key="FilterChipBase" TargetType="Button">
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Thẻ Material kèm Hover -->
    <Style x:Key="TextLinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MaterialCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="BorderBrush" Value="{StaticResource Gray200}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#E74C3C"/>
                <Setter Property="Background" Value="#FFF5F5"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#E74C3C" Opacity="0.15"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</UserControl.Resources>

<Grid>
    <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8FAFC" Offset="0"/>
            <GradientStop Color="#F1F5F9" Offset="0.5"/>
            <GradientStop Color="#F8FAFC" Offset="1"/>
        </LinearGradientBrush>
    </Grid.Background>
<!-- Nội dung Chính -->
<Grid Margin="30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề SECTION -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tiêu đề -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="14" Width="48" Height="48" Margin="0,0,16,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#5B6AFF" Offset="0"/>
                            <GradientStop Color="#818CF8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <ui:SymbolIcon Symbol="Archive24" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Quản lý tồn kho" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Gray900}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Nút Làm mới -->
            <Button Grid.Column="2" Command="{Binding RefreshCommand}" Cursor="Hand" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="White" BorderBrush="{StaticResource Gray200}" BorderThickness="1" CornerRadius="10" Width="44" Height="44">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="18" Foreground="{StaticResource Gray600}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Gray100}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Nút Thêm tồn kho -->
            <Button Grid.Column="4" Command="{Binding GoToPhieuNhapCommand}" Cursor="Hand" VerticalAlignment="Center"
                    Visibility="{Binding CanViewThemTonKho, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#2ECC71" BorderBrush="#27AE60" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Thêm tồn kho" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27AE60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Nút Xuất kho -->
            <Button Grid.Column="6" Command="{Binding GoToPhieuXuatCommand}" Cursor="Hand" VerticalAlignment="Center"
                    Visibility="{Binding CanViewXuatKho, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#E74C3C" BorderBrush="#C0392B" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Xuất kho" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C0392B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Nút Hệ Số Quy Đổi -->
            <Button Grid.Column="8" Command="{Binding OpenQuyDoiPopupCommand}" Cursor="Hand" VerticalAlignment="Center"
                    Visibility="{Binding CanViewHeSoQuyDoi, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="White" BorderBrush="{StaticResource Gray200}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Filter24" FontSize="14" Foreground="{StaticResource Gray600}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Hệ số quy đổi" FontSize="13" Foreground="{StaticResource Gray600}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Gray50}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Nút Cảnh báo HSD -->
            <Button Grid.Column="10" Command="{Binding OpenLoHangPopupCommand}" Cursor="Hand" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning24" FontSize="14" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Cảnh báo HSD" FontSize="13" FontWeight="SemiBold" Foreground="#D97706"/>
                                <Border Background="#EF4444" CornerRadius="10" MinWidth="20" Height="20" Margin="6,0,0,0" Padding="6,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SoLoHangCanhBao}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SoLoHangCanhBao}" FontSize="11" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEF3C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Tổng nguyên liệu -->
            <Border Grid.Column="12" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1.5" CornerRadius="14" Padding="12,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="10" Width="36" Height="36" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5B6AFF" Offset="0"/>
                                <GradientStop Color="#818CF8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ui:SymbolIcon Symbol="DataBarVertical24" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tổng nguyên liệu" FontSize="11" Foreground="{StaticResource Gray500}"/>
                        <TextBlock Text="{Binding SoNguyenLieuTonKho}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Gray900}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Đơn vị tính -->
            <Border Grid.Column="14"
                    Background="#F0FDF4"
                    BorderBrush="#BBF7D0"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Padding="12,8"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenDonViTinhPopupCommand}"/>
                </Border.InputBindings>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="10" Width="36" Height="36" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#22C55E" Offset="0"/>
                                <GradientStop Color="#4ADE80" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Đơn vị tính" FontSize="11" Foreground="{StaticResource Gray500}"/>
                        <TextBlock Text="{Binding DonViTinhs.Count}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Gray900}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tìm kiếm & FILTER BAR -->
        <Border Grid.Row="1"
                Style="{StaticResource HoverCardStyle}"
                Padding="20,14"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Hộp Tìm kiếm -->
                <Border Grid.Column="0"
                        CornerRadius="12"
                        Padding="14,10"
                        BorderThickness="1.5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Gray50}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Gray200}"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="#E74C3C"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#E74C3C" Opacity="0.12"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="17" Foreground="{StaticResource Gray400}" VerticalAlignment="Center" Margin="2,0,12,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="Tìm kiếm tên hoặc mã nguyên liệu..."
                                   Foreground="{StaticResource Gray400}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Padding="4,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 Padding="0"
                                 Foreground="{StaticResource Gray800}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>

                <!-- Bộ lọc Thẻ -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tất Cả -->
                    <Button Command="{Binding FilterTatCaCommand}" Style="{StaticResource FilterChipBase}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="chipBorder"
                                        Background="Transparent"
                                        CornerRadius="20"
                                        Padding="18,9"
                                        BorderBrush="{StaticResource Gray300}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon x:Name="chipDot" Symbol="Checkmark24" FontSize="14" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,6,0" Visibility="Collapsed"/>
                                        <TextBlock x:Name="chipText" Text="Tất Cả" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Gray600}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="TatCa">
                                        <Setter TargetName="chipBorder" Property="Background" Value="#E74C3C"/>
                                        <Setter TargetName="chipBorder" Property="BorderBrush" Value="#E74C3C"/>
                                        <Setter TargetName="chipText" Property="Foreground" Value="White"/>
                                        <Setter TargetName="chipDot" Property="Foreground" Value="White"/>
                                        <Setter TargetName="chipDot" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="chipBorder" Property="BorderBrush" Value="#E74C3C"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tồn Thấp -->
                    <Button Command="{Binding FilterTonThapCommand}" Style="{StaticResource FilterChipBase}" Margin="8,0,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="chipBorder"
                                        Background="Transparent"
                                        CornerRadius="20"
                                        Padding="18,9"
                                        BorderBrush="{StaticResource Gray300}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon x:Name="chipDot" Symbol="Checkmark24" FontSize="14" Foreground="{StaticResource DangerRed}" Margin="0,0,6,0" Visibility="Collapsed"/>
                                        <TextBlock x:Name="chipText" Text="Tồn Thấp" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Gray600}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="TonThap">
                                        <Setter TargetName="chipBorder" Property="Background" Value="{StaticResource DangerRed}"/>
                                        <Setter TargetName="chipBorder" Property="BorderBrush" Value="{StaticResource DangerRed}"/>
                                        <Setter TargetName="chipText" Property="Foreground" Value="White"/>
                                        <Setter TargetName="chipDot" Property="Foreground" Value="White"/>
                                        <Setter TargetName="chipDot" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="chipBorder" Property="BorderBrush" Value="{StaticResource DangerRed}"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tồn Cao -->
                    <Button Command="{Binding FilterTonCaoCommand}" Style="{StaticResource FilterChipBase}" Margin="8,0,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="chipBorder"
                                        Background="Transparent"
                                        CornerRadius="20"
                                        Padding="18,9"
                                        BorderBrush="{StaticResource Gray300}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon x:Name="chipDot" Symbol="Checkmark24" FontSize="14" Foreground="{StaticResource SuccessGreen}" Margin="0,0,6,0" Visibility="Collapsed"/>
                                        <TextBlock x:Name="chipText" Text="Tồn Cao" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Gray600}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="TonCao">
                                        <Setter TargetName="chipBorder" Property="Background" Value="{StaticResource SuccessGreen}"/>
                                        <Setter TargetName="chipBorder" Property="BorderBrush" Value="{StaticResource SuccessGreen}"/>
                                        <Setter TargetName="chipText" Property="Foreground" Value="White"/>
                                        <Setter TargetName="chipDot" Property="Foreground" Value="White"/>
                                        <Setter TargetName="chipDot" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="chipBorder" Property="BorderBrush" Value="{StaticResource SuccessGreen}"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bảng Dữ liệu -->
        <Border Grid.Row="2"
                Style="{StaticResource HoverCardStyle}"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề Bảng -->
                <Border Grid.Row="0"
                        Background="{StaticResource Gray50}"
                        CornerRadius="16,16,0,0"
                        Padding="28,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Mã NL" FontWeight="SemiBold" Foreground="{StaticResource Gray500}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Tên Nguyên Liệu" FontWeight="SemiBold" Foreground="{StaticResource Gray500}" FontSize="13" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="Số Lượng" FontWeight="SemiBold" Foreground="{StaticResource Gray500}" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Đơn Vị" FontWeight="SemiBold" Foreground="{StaticResource Gray500}" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="Trạng Thái" FontWeight="SemiBold" Foreground="{StaticResource Gray500}" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="Cảnh báo HSD" FontWeight="SemiBold" Foreground="{StaticResource Gray500}" FontSize="13" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Hàng Bảng -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0,4,0,8">
                    <ItemsControl ItemsSource="{Binding FilteredTonKhoItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="28,14"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource Gray100}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FAFBFF"/>
                                                    <Setter Property="BorderBrush" Value="#E8EAFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mã NL -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding MaNguyenLieu}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource Gray600}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Tên kèm Hình ảnh -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Border Width="40" Height="40"
                                                    CornerRadius="20"
                                                    Background="{StaticResource Gray100}"
                                                    Margin="0,0,14,0">
                                                <Grid>
                                                    <Border CornerRadius="20" ClipToBounds="True">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HinhAnh}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HinhAnh}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <ui:SymbolIcon Symbol="Box24" FontSize="18"
                                                               Foreground="{StaticResource Gray400}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HinhAnh}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HinhAnh}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding TenNguyenLieu}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Gray800}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Số lượng -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SoLuongTon, StringFormat=\{0:0.##\}}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource Gray900}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <!-- Đơn vị -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding DonViTinh}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource Gray500}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <!-- Thẻ Trạng thái -->
                                        <Border Grid.Column="4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                CornerRadius="12"
                                                Padding="14,4,14,5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding MucDoTonKho}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Cảnh báo HSD inline -->
                                        <Button Grid.Column="5"
                                                Command="{Binding ViewExpiryDetailCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="hsdBorder" Background="Transparent" CornerRadius="8" Padding="10,5">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <!-- Chấm đỏ khi có cảnh báo -->
                                                            <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasExpirySoon}" Value="True">
                                                                                <Setter Property="Background" Value="#EF4444"/>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                            <TextBlock Text="Xem chi tiết" FontSize="12" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource Gray500}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasExpirySoon}" Value="True">
                                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="hsdBorder" Property="Background" Value="#FEF3C7"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Trạng thái Trống -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredTonKhoItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="80" Height="80" CornerRadius="40" Background="{StaticResource Gray100}" Margin="0,0,0,16" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Archive24" FontSize="36" Foreground="{StaticResource Gray300}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Không tìm thấy nguyên liệu"
                               FontSize="16"
                               FontWeight="Medium"
                               Foreground="{StaticResource Gray400}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm"
                               FontSize="13"
                               Foreground="{StaticResource Gray400}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

        <!-- MANAGEMENT POPUP -->
        <Grid Visibility="{Binding IsQuyDoiPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- Nền phủ -->
            <Border Background="#000000" Opacity="0.5">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseQuyDoiPopupCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Thẻ Popup -->
            <Border Width="920"
                    Height="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="20"
                    Background="White">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="48" ShadowDepth="0" Color="#000000" Opacity="0.2"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tiêu đề Popup -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderGradient}"
                            CornerRadius="20,20,0,0"
                            Padding="28,22">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Quản Lý Hệ Số Quy Đổi"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="Cài đặt hệ số chuyển đổi giữa các đơn vị tính"
                                           FontSize="13"
                                           Foreground="White"
                                           Opacity="0.85"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <Button Style="{StaticResource CircularCloseButtonStyle}" Command="{Binding CloseQuyDoiPopupCommand}" Margin="0,-16,-16,0" Panel.ZIndex="10"/>
                        </Grid>
                    </Border>

                    <!-- Nội dung Popup -->
                    <Grid Grid.Row="1" Margin="28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Panel Trái -->
                        <Border Grid.Column="0"
                                Background="{StaticResource Gray50}"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Bộ lọc Danh mục -->
                                <Border Grid.Row="0"
                                        Background="White"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,14">
                                    <ComboBox Background="Transparent"
                                              BorderThickness="0"
                                              ItemsSource="{Binding LoaiNguyenLieus}"
                                              SelectedItem="{Binding SelectedLoaiNguyenLieu}"
                                              DisplayMemberPath="TenLoai"
                                              FontSize="14"/>
                                </Border>

                                <!-- Lưới Nguyên liệu -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredNguyenLieus}" HorizontalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel HorizontalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource MaterialCard}"
                                                        Width="100"
                                                        Margin="4">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.SelectNguyenLieuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border Width="54" Height="54"
                                                                CornerRadius="27"
                                                                Background="{StaticResource LightBlue}"
                                                                Margin="0,0,0,10">
                                                            <Grid>
                                                                <!-- Hình ảnh -->
                                                                <Border CornerRadius="27" ClipToBounds="True">
                                                                    <Border.Background>
                                                                        <ImageBrush ImageSource="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill"/>
                                                                    </Border.Background>
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HinhAnh}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding HinhAnh}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>

                                                                <!-- Icon Thay thế -->
                                                                <ui:SymbolIcon Symbol="Box24" FontSize="22"
                                                                           Foreground="{StaticResource Gray400}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center">
                                                                    <ui:SymbolIcon.Style>
                                                                        <Style TargetType="ui:SymbolIcon">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HinhAnh}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding HinhAnh}" Value="">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ui:SymbolIcon.Style>
                                                                </ui:SymbolIcon>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Text="{Binding TenNguyenLieu}"
                                                                   FontSize="12"
                                                                   FontWeight="Medium"
                                                                   Foreground="{StaticResource Gray800}"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="85"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Panel Phải -->
                        <Border Grid.Column="1"
                                Background="White"
                                CornerRadius="12"
                                Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Nguyên liệu đã chọn -->
                                <TextBlock Grid.Row="0"
                                           Text="{Binding SelectedNguyenLieu.TenNguyenLieu, FallbackValue='Chọn Nguyên Liệu'}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Gray800}"
                                           Margin="0,0,0,10"/>

                                <!-- Bảng Quy đổi -->
                                <Border Grid.Row="2"
                                        BorderBrush="{StaticResource Gray200}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Tiêu đề Bảng -->
                                        <Border Grid.Row="0"
                                                Background="{StaticResource Gray50}"
                                                CornerRadius="12,12,0,0"
                                                Padding="16,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Đơn Vị" FontWeight="SemiBold" Foreground="{StaticResource Gray500}" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Hệ Số" FontWeight="SemiBold" Foreground="{StaticResource Gray500}" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="ĐV Lưu Tồn Kho" FontWeight="SemiBold" Foreground="{StaticResource Gray500}" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3"/>
                                            </Grid>
                                        </Border>

                                        <!-- Nội dung bảng -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding QuyDoiDonVis}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Gray200}" BorderThickness="0,0,0,1" Padding="14,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="150"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="100"/>
                                                                    <ColumnDefinition Width="50"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding TenDonVi}"
                                                                           FontSize="14"
                                                                           Foreground="{StaticResource Gray800}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>

                                                                <!-- Hệ số chỉnh sửa -->
                                                                <Border Grid.Column="1"
                                                                        Background="{StaticResource Gray50}"
                                                                        CornerRadius="6"
                                                                        Padding="8,4"
                                                                        HorizontalAlignment="Center">
                                                                    <TextBox Text="{Binding HeSoText, UpdateSourceTrigger=PropertyChanged}" behaviors:NumericInputBehavior.IsDecimalOnly="True"
                                                                             Background="Transparent"
                                                                             BorderThickness="0"
                                                                             FontWeight="SemiBold"
                                                                             FontSize="14"
                                                                             Foreground="{StaticResource PrimaryBlue}"
                                                                             IsReadOnly="{Binding LaDonViChuan}"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             TextAlignment="Center"
                                                                             Width="100"/>
                                                                </Border>

                                                                <CheckBox Grid.Column="2"
                                                                          IsChecked="{Binding LaDonViChuan}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>

                                                                <!-- Delete button - ẩn với đơn vị gốc -->
                                                                <Button Grid.Column="3"
                                                                        Command="{Binding DeleteCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource IconButton}"
                                                                        Visibility="{Binding IsBaseUnit, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                                        ToolTip="Xóa quy đổi"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                    <ui:SymbolIcon Symbol="Delete24" Foreground="{StaticResource DangerRed}"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- Nút Hành động -->
                                <StackPanel Grid.Row="3"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,18,0,0">
                                    <Button Content="Lưu"
                                            Style="{StaticResource PrimaryButton}"
                                            Background="{StaticResource SuccessGreen}"
                                            Width="110"
                                            Margin="0,0,10,0"
                                            Command="{Binding SaveCommand}"/>
                                    <Button Content="Thêm Mới"
                                            Style="{StaticResource PrimaryButton}"
                                            Background="{StaticResource WarningOrange}"
                                            Width="120"
                                            Command="{Binding AddQuyDoiCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ADD NEW POPUP -->
        <Grid Visibility="{Binding IsAddQuyDoiPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#000000" Opacity="0.5">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAddQuyDoiPopupCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border Width="460"
                    Height="Auto"
                    CornerRadius="20"
                    Background="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="48" ShadowDepth="0" Color="#000000" Opacity="0.2"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tiêu đề -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderGradient}"
                            CornerRadius="20,20,0,0"
                            Padding="26,20">
                        <Grid>
                            <TextBlock Text="Thêm Hệ Số Quy Đổi Mới"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <Button Style="{StaticResource CircularCloseButtonStyle}" Command="{Binding CloseAddQuyDoiPopupCommand}" Margin="0,-16,-16,0" Panel.ZIndex="10"/>
                        </Grid>
                    </Border>

                    <!-- Biểu mẫu -->
                    <StackPanel Grid.Row="1" Margin="26,22">

                        <TextBlock Text="Đơn vị quy đổi"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Gray600}"
                                   FontSize="13"
                                   Margin="0,0,0,8"/>
                        <Border Background="{StaticResource Gray50}"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,0,0,18"
                                BorderBrush="{StaticResource Gray200}"
                                BorderThickness="1">
                            <ComboBox Background="Transparent"
                                      BorderThickness="0"
                                      ItemsSource="{Binding DonViTinhs}"
                                      SelectedItem="{Binding SelectedDonViXuat}"
                                      DisplayMemberPath="TenDonVi"
                                      FontSize="14"/>
                        </Border>

                        <TextBlock Text="Nhập hệ số"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Gray600}"
                                   FontSize="13"
                                   Margin="0,0,0,8"/>
                        <Border Background="{StaticResource Gray50}"
                                CornerRadius="10"
                                Padding="4"
                                Margin="0,0,0,24"
                                BorderBrush="{StaticResource Gray200}"
                                BorderThickness="1">
                            <TextBox Background="Transparent"
                                     BorderThickness="0"
                                     Text="{Binding HeSoNhap, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="15"
                                     Padding="10"/>
                        </Border>

                        <Button Content="Lưu Hệ Số"
                                Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource SuccessGreen}"
                                HorizontalAlignment="Stretch"
                                Padding="0,14"
                                FontSize="15"
                                Command="{Binding SaveNewQuyDoiCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    <!-- POPUP: Quản lý lô hàng & Cảnh báo HSD -->
    <Grid Visibility="{Binding IsLoHangPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}">
        <!-- Overlay nền mờ -->
        <Border Background="#80000000">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseLoHangPopupCommand}"/>
            </Border.InputBindings>
        </Border>

        <!-- Popup Card -->
        <Border Background="White" CornerRadius="20" Width="900" MaxHeight="650" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.15"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="20,20,0,0" Padding="28,22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F59E0B" Offset="0"/>
                            <GradientStop Color="#EF4444" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="12" Width="44" Height="44" Background="#40FFFFFF" Margin="0,0,14,0">
                                <ui:SymbolIcon Symbol="Warning24" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Quản lý lô hàng &amp; Cảnh báo HSD" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Theo dõi hạn sử dụng theo từng lô nhập kho (số lượng còn lại theo FIFO)" FontSize="12" Foreground="#E0FFFFFF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding CloseLoHangPopupCommand}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="closeBg" Background="#30FFFFFF" CornerRadius="8" Width="32" Height="32">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="closeBg" Property="Background" Value="#50FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Tabs -->
                <Border Grid.Row="1" Background="{StaticResource Gray50}" Padding="28,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SwitchLoHangTabCommand}" CommandParameter="CanhBao" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="tabBorder" CornerRadius="10" Padding="16,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedLoHangTab}" Value="CanhBao">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Warning24" FontSize="14" Margin="0,0,6,0">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Foreground" Value="{StaticResource Gray500}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedLoHangTab}" Value="CanhBao">
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Text="Sắp/Hết hạn" FontSize="13" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Gray500}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedLoHangTab}" Value="CanhBao">
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Background="#EF4444" CornerRadius="8" MinWidth="20" Height="18" Margin="6,0,0,0" Padding="5,0">
                                                <TextBlock Text="{Binding SoLoHangCanhBao}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Nội dung tab -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,0,20">
                    <StackPanel>
                        <!-- Tab Cảnh báo -->
                        <ItemsControl ItemsSource="{Binding LoHangCanhBaoItems}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLoHangTab}" Value="CanhBao">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Gray100}" BorderThickness="0,0,0,1" Padding="28,14" Margin="0,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Gray50}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding TenNguyenLieu}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Gray800}"/>
                                                <TextBlock Text="{Binding DonVi}" FontSize="11" Foreground="{StaticResource Gray400}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Mã PN" FontSize="10" Foreground="{StaticResource Gray400}"/>
                                                <TextBlock Text="{Binding MaPhieuNhap}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Gray700}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="Còn lại" FontSize="10" Foreground="{StaticResource Gray400}"/>
                                                <TextBlock Text="{Binding SoLuongNhap, StringFormat=N2}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Gray700}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="Hạn sử dụng" FontSize="10" Foreground="{StaticResource Gray400}"/>
                                                <TextBlock Text="{Binding HSDText}" FontSize="12" FontWeight="Bold" Foreground="#D97706"/>
                                            </StackPanel>

                                            <Border Grid.Column="4" CornerRadius="8" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TrangThaiHSD}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <Button Grid.Column="5"
                                                    Style="{StaticResource TextLinkButton}"
                                                    Command="{Binding DataContext.ViewPhieuNhapCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding PhieuNhapID}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="Xem phiếu nhập" Foreground="#5B6AFF" FontSize="12" FontWeight="Medium"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Tab Tất cả -->
                        <ItemsControl ItemsSource="{Binding AllLoHangItems}" Visibility="Collapsed">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLoHangTab}" Value="TatCa">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Gray100}" BorderThickness="0,0,0,1" Padding="28,14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Gray50}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding TenNguyenLieu}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Gray800}"/>
                                                <TextBlock Text="{Binding DonVi}" FontSize="11" Foreground="{StaticResource Gray400}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Mã PN" FontSize="10" Foreground="{StaticResource Gray400}"/>
                                                <TextBlock Text="{Binding MaPhieuNhap}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Gray700}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="Còn lại" FontSize="10" Foreground="{StaticResource Gray400}"/>
                                                <TextBlock Text="{Binding SoLuongNhap, StringFormat=N2}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Gray700}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="Hạn sử dụng" FontSize="10" Foreground="{StaticResource Gray400}"/>
                                                <TextBlock Text="{Binding HSDText}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsNearExpiry}" Value="True">
                                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Grid.Column="4" CornerRadius="8" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#D1FAE5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsNearExpiry}" Value="True">
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TrangThaiHSD}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#059669"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsNearExpiry}" Value="True">
                                                                    <Setter Property="Foreground" Value="#D97706"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <Button Grid.Column="5"
                                                    Style="{StaticResource TextLinkButton}"
                                                    Command="{Binding DataContext.ViewPhieuNhapCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding PhieuNhapID}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="Xem phiếu nhập" Foreground="#5B6AFF" FontSize="12" FontWeight="Medium"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Trạng thái trống (cảnh báo) -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,40">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedLoHangTab}" Value="CanhBao"/>
                                                <Condition Binding="{Binding LoHangCanhBaoItems.Count}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="56" Height="56" CornerRadius="28" Background="#D1FAE5" Margin="0,0,0,12" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="26" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Không có lô hàng nào sắp hết hạn" FontSize="14" FontWeight="Medium" Foreground="{StaticResource Gray600}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Các lô hàng hiện đều trong thời hạn sử dụng" FontSize="12" Foreground="{StaticResource Gray400}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

    <!-- POPUP: Chi tiết lô hàng theo nguyên liệu -->
    <Grid Visibility="{Binding IsNguyenLieuLoHangPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}"
          Background="#80000000">
        <Border Background="White" CornerRadius="20" Width="700" MaxHeight="500"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="48" ShadowDepth="0" Color="#000000" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource Gray800}">
                            <Run Text="Chi tiết lô hàng HSD — "/>
                            <Run Text="{Binding SelectedNguyenLieuName, Mode=OneWay}" Foreground="#D97706"/>
                        </TextBlock>
                        <TextBlock Text="Danh sách các lô hàng còn tồn theo FIFO, kèm mã phiếu nhập và hạn sử dụng"
                                   FontSize="12" Foreground="{StaticResource Gray400}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource CircularCloseButtonStyle}"
                            Command="{Binding CloseNguyenLieuLoHangPopupCommand}"
                            Margin="0,-16,-16,0" Panel.ZIndex="10"/>
                </Grid>

                <!-- Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="350">
                    <StackPanel>
                        <!-- Danh sách lô hàng -->
                        <ItemsControl ItemsSource="{Binding SelectedNguyenLieuLoHang}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" CornerRadius="10" Padding="14,10"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Gray100}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNearExpiry}" Value="True">
                                                        <Setter Property="Background" Value="#FFFBEB"/>
                                                        <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Gray800}">
                                                        <Run Text="Mã phiếu: "/>
                                                        <Run Text="{Binding MaPhieuNhap, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text=" — " FontSize="13" Foreground="{StaticResource Gray400}"/>
                                                    <TextBlock FontSize="13" Foreground="{StaticResource Gray500}">
                                                        <Run Text="Ngày nhập: "/>
                                                        <Run Text="{Binding NgayNhapText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock FontSize="12" Foreground="{StaticResource Gray500}">
                                                        <Run Text="Còn: "/>
                                                        <Run Text="{Binding SoLuongNhap, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding DonVi, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text=" │ " FontSize="12" Foreground="{StaticResource Gray300}" Margin="8,0"/>
                                                    <TextBlock FontSize="12" Foreground="{StaticResource Gray500}">
                                                        <Run Text="HSD: "/>
                                                        <Run Text="{Binding HSDText, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#D1FAE5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNearExpiry}" Value="True">
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TrangThaiHSD}" FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Foreground>
                                                        <Binding Path="MauTrangThai"/>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource TextLinkButton}"
                                                    Command="{Binding DataContext.ViewPhieuNhapCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding PhieuNhapID}"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                                <TextBlock Text="Xem phiếu" Foreground="#5B6AFF" FontSize="12" FontWeight="Medium"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNguyenLieuLoHang.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="50" Height="50" CornerRadius="25" Background="#D1FAE5" Margin="0,0,0,12" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="22" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Không có lô hàng còn tồn" FontSize="14" FontWeight="Medium" Foreground="{StaticResource Gray600}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Nguyên liệu này hiện không có lô nhập nào còn số lượng" FontSize="12" Foreground="{StaticResource Gray400}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

    <!-- POPUP: Quản lý đơn vị tính -->
    <Grid Visibility="{Binding IsDonViTinhPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}">
        <Border Background="#80000000">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDonViTinhPopupCommand}"/>
            </Border.InputBindings>
        </Border>

        <Border Width="520" MaxHeight="620" CornerRadius="20" Background="White"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="48" ShadowDepth="0" Color="#000000" Opacity="0.2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề -->
                <Border Grid.Row="0" CornerRadius="20,20,0,0" Padding="26,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#22C55E" Offset="0"/>
                            <GradientStop Color="#4ADE80" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Quản lý đơn vị tính" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Thêm, sửa, xóa các đơn vị tính trong hệ thống" FontSize="13" Foreground="White" Opacity="0.85" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource CircularCloseButtonStyle}" Command="{Binding CloseDonViTinhPopupCommand}" Margin="0,-16,-16,0" Panel.ZIndex="10"/>
                    </Grid>
                </Border>

                <!-- Form thêm/sửa -->
                <Border Grid.Row="1" Padding="26,20,26,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource Gray50}" CornerRadius="10" Padding="4" BorderBrush="{StaticResource Gray200}" BorderThickness="1">
                            <TextBox Background="Transparent" BorderThickness="0"
                                     Text="{Binding NewDonViTinhName, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Padding="10"/>
                        </Border>
                        <Button Grid.Column="1" Command="{Binding SaveDonViTinhCommand}" Margin="10,0,0,0" Padding="20,10" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnSaveDvt2" CornerRadius="10" Padding="{TemplateBinding Padding}" Cursor="Hand">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#22C55E" Offset="0"/>
                                                <GradientStop Color="#4ADE80" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="White" Margin="0,0,6,0"/>
                                            <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Thêm"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditingDonViTinh}" Value="True">
                                                                <Setter Property="Text" Value="Lưu"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnSaveDvt2" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding CancelEditDonViTinhCommand}" Margin="6,0,0,0" Padding="12,10" Cursor="Hand"
                                Visibility="{Binding IsEditingDonViTinh, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bdCancelDvt2" Background="{StaticResource Gray100}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{StaticResource Gray600}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bdCancelDvt2" Property="Background" Value="{StaticResource Gray200}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Bảng danh sách đơn vị tính -->
                <Border Grid.Row="2" Margin="26,16,26,26" BorderBrush="{StaticResource Gray200}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource Gray50}" CornerRadius="12,12,0,0" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="STT" FontWeight="SemiBold" Foreground="{StaticResource Gray500}" FontSize="13" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Tên đơn vị" FontWeight="SemiBold" Foreground="{StaticResource Gray500}" FontSize="13" Margin="12,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="Thao tác" FontWeight="SemiBold" Foreground="{StaticResource Gray500}" FontSize="13" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="350">
                            <ItemsControl ItemsSource="{Binding DonViTinhs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Gray200}" BorderThickness="0,0,0,1" Padding="16,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DonViID}" FontSize="14" Foreground="{StaticResource Gray500}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TenDonVi}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource Gray800}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Command="{Binding DataContext.EditDonViTinhCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource IconButton}" ToolTip="Sửa" Margin="0,0,4,0">
                                                        <ui:SymbolIcon Symbol="Edit24" Foreground="{StaticResource PrimaryBlue}"/>
                                                    </Button>
                                                    <Button Command="{Binding DataContext.DeleteDonViTinhCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource IconButton}" ToolTip="Xóa">
                                                        <ui:SymbolIcon Symbol="Delete24" Foreground="{StaticResource DangerRed}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

</Grid>
</UserControl>
