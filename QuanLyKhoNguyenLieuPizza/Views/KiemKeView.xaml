<UserControl x:Class="QuanLyKhoNguyenLieuPizza.Views.KiemKeView"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:QuanLyKhoNguyenLieuPizza.Views.Components"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:vm="clr-namespace:QuanLyKhoNguyenLieuPizza.ViewModels"
         xmlns:converters="clr-namespace:QuanLyKhoNguyenLieuPizza.Converters"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         mc:Ignorable="d"
         d:DesignHeight="700" d:DesignWidth="1100"
         Background="{StaticResource SoftWhiteBrush}">

<UserControl.Resources>
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

    <!-- Custom Blue ComboBox Style for Unit Selection to fix clipping -->
    <ControlTemplate x:Key="BlueComboBoxToggleButton" TargetType="ToggleButton">
        <Grid>
            <Border x:Name="Border" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="12"/>
            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource Gray500}" StrokeThickness="1.5" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" Margin="0,0,10,0"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Arrow" Property="Data" Value="M 0 4 L 4 0 L 8 4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="BlueComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Gray800}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Style="{x:Null}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Template="{StaticResource BlueComboBoxToggleButton}" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="20,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border x:Name="DropDownBorder" Background="White" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Effect="{StaticResource CardShadowMedium}" Margin="0,4,0,0"/>
                                <ScrollViewer Margin="4,8" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid Header Styles -->
    <Style x:Key="KiemKeColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#1E293B"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="BorderBrush" Value="#334155"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="SeparatorBrush" Value="Transparent"/>
    </Style>

    <Style x:Key="CenteredKiemKeColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource KiemKeColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
</UserControl.Resources>

<Grid>
    <!-- 1) MÀN HÌNH CHÍNH: DANH SÁCH PHIẾU -->
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFormVisible}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDetailVisible}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="24,20,24,0" Padding="24,20" Background="White" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#1E293B" Opacity="0.06"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DANH SÁCH PHIẾU KIỂM KÊ" FontSize="22" FontWeight="Bold" Foreground="#1E293B"
                               FontFamily="Segoe UI Variable, Segoe UI, Arial"/>
                    <TextBlock Text="Quản lý kiểm kê kho nguyên liệu" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding CreatePhieuCommand}" Style="{StaticResource SuccessButtonStyle}" Padding="20,12">
                    <TextBlock Text="+ Lập Phiếu Mới" FontWeight="SemiBold" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- Bộ lọc -->
        <Border Grid.Row="1" Margin="24,12,24,0" Padding="20,16" Background="#F8FAFC" BorderBrush="{StaticResource Gray200}" BorderThickness="1.5" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mã phiếu kiểm -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Mã phiếu kiểm" FontSize="12" Foreground="{StaticResource Gray500}" Margin="4,0,0,6" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource ModernInputBorder}">
                        <Grid>
                            <TextBox x:Name="txtSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                     Style="{StaticResource ModernTextBoxStyle}" Padding="12,10" BorderThickness="0" Background="Transparent"/>
                            <TextBlock Text="Nhập mã phiếu..." Style="{StaticResource PlaceholderStyle}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding Text, ElementName=txtSearch, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Từ ngày -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Từ ngày" FontSize="12" Foreground="{StaticResource Gray500}" Margin="4,0,0,6" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource ModernInputBorder}">
                        <DatePicker SelectedDate="{Binding TuNgay}" BorderThickness="0" Background="Transparent" Padding="4,8" Language="vi-VN"/>
                    </Border>
                </StackPanel>

                <!-- Đến ngày -->
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Đến ngày" FontSize="12" Foreground="{StaticResource Gray500}" Margin="4,0,0,6" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource ModernInputBorder}">
                        <DatePicker SelectedDate="{Binding DenNgay}" BorderThickness="0" Background="Transparent" Padding="4,8" Language="vi-VN"/>
                    </Border>
                </StackPanel>

                <!-- Trạng thái -->
                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                    <TextBlock Text="Trạng thái" FontSize="12" Foreground="{StaticResource Gray500}" Margin="4,0,0,6" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource ModernInputBorder}">
                        <ComboBox ItemsSource="{Binding TrangThaiOptions}" SelectedItem="{Binding SelectedTrangThaiFilter}"
                                  BorderThickness="0" Background="Transparent" Padding="12,10" VerticalContentAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Tìm Kiếm Button -->
                <Button Grid.Column="4" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}"
                        Width="120" Height="42" Padding="0" VerticalAlignment="Bottom" Cursor="Hand">
                    <TextBlock Text="Tìm Kiếm" FontWeight="Bold" FontSize="14"/>
                </Button>

                <!-- Xóa Lọc Button -->
                <Button Grid.Column="5" Command="{Binding ClearFilterCommand}" Style="{StaticResource OutlineButton}"
                        Width="120" Height="42" Padding="0" VerticalAlignment="Bottom" Margin="10,0,0,0" Cursor="Hand">
                    <TextBlock Text="Xóa Lọc" FontWeight="Bold" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- Bảng danh sách -->
        <Border Grid.Row="2" Margin="24,12,24,20" Background="White" CornerRadius="16" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#1E293B" Opacity="0.06"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid ItemsSource="{Binding PhieuKiemKes}" SelectedItem="{Binding SelectedPhieuKiemKe}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="52"
                          Background="White" BorderThickness="0"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          AlternationCount="9999" x:Name="dgPhieuKiemKe"
                          ColumnHeaderStyle="{StaticResource KiemKeColumnHeaderStyle}">

                    <DataGrid.Columns>
                        <!-- STT Column -->
                        <DataGridTemplateColumn Header="STT" Width="60" HeaderStyle="{StaticResource CenteredKiemKeColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource AddOneConverter}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Gray500}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Mã Phiếu -->
                        <DataGridTemplateColumn Header="Mã Phiếu" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MaPhieuKiem}" FontWeight="SemiBold" Foreground="{StaticResource Gray800}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Ngày Lập" Binding="{Binding NgayKiem, StringFormat=dd/MM/yyyy HH:mm}" Width="1.5*"/>
                        <DataGridTextColumn Header="Nhân Viên Kiểm" Binding="{Binding NhanVienKiem.HoTen}" Width="2*"/>
                        <DataGridTextColumn Header="Người Duyệt" Binding="{Binding NhanVienDuyet.HoTen}" Width="2*"/>

                        <!-- Ngày Duyệt -->
                        <DataGridTextColumn Header="Ngày Duyệt" Binding="{Binding NgayDuyet, StringFormat=dd/MM/yyyy}" Width="1.2*" HeaderStyle="{StaticResource CenteredKiemKeColumnHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Trạng thái badge -->
                        <DataGridTemplateColumn Header="Trạng Thái" Width="1.3*" HeaderStyle="{StaticResource CenteredKiemKeColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="12,6" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="Chờ Duyệt">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="Đã Duyệt">
                                                        <Setter Property="Background" Value="#D1FAE5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="Đã Hủy">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TrangThai}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#6B7280"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="Chờ Duyệt">
                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="Đã Duyệt">
                                                            <Setter Property="Foreground" Value="#059669"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="Đã Hủy">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Nút thao tác -->
                        <DataGridTemplateColumn Header="Thao Tác" Width="1.5*" HeaderStyle="{StaticResource CenteredKiemKeColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center">
                                        <!-- Đối soát (Chờ Duyệt) -->
                                        <Button Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Cursor="Hand" Visibility="Collapsed" x:Name="btnDoiSoat">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="#EFF6FF" CornerRadius="8" Padding="12,6">
                                                        <TextBlock x:Name="text" Text="Đối soát" FontSize="12" Foreground="#2563EB" FontWeight="Bold"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#DBEAFE"/>
                                                            <Setter TargetName="text" Property="Foreground" Value="#1D4ED8"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#BFDBFE"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Xem chi tiết (Đã Duyệt) -->
                                        <Button Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Cursor="Hand" Visibility="Collapsed" x:Name="btnXemChiTiet">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="#F1F5F9" CornerRadius="8" Padding="12,6">
                                                        <TextBlock x:Name="text" Text="Xem chi tiết" FontSize="12" Foreground="#475569" FontWeight="Bold"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                                            <Setter TargetName="text" Property="Foreground" Value="#1E293B"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Tiếp tục đếm (Bản Nháp) -->
                                        <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Cursor="Hand" Visibility="Collapsed" x:Name="btnTiepTucDem">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="#EEF2FF" CornerRadius="8" Padding="12,6">
                                                        <TextBlock x:Name="text" Text="Tiếp tục đếm" FontSize="12" Foreground="#4F46E5" FontWeight="Bold"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#DCE0FF"/>
                                                            <Setter TargetName="text" Property="Foreground" Value="#3730A3"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#C7D2FE"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Xem lý do (Đã Hủy) -->
                                        <Button Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Cursor="Hand" Visibility="Collapsed" x:Name="btnXemLyDo">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="#FEF2F2" CornerRadius="8" Padding="12,6">
                                                        <TextBlock x:Name="text" Text="Xem lý do" FontSize="12" Foreground="#DC2626" FontWeight="Bold"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                                            <Setter TargetName="text" Property="Foreground" Value="#991B1B"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#FCA5A5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding TrangThai}" Value="Chờ Duyệt">
                                            <Setter TargetName="btnDoiSoat" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TrangThai}" Value="Đã Duyệt">
                                            <Setter TargetName="btnXemChiTiet" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TrangThai}" Value="Bản Nháp">
                                            <Setter TargetName="btnTiepTucDem" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TrangThai}" Value="Đã Hủy">
                                            <Setter TargetName="btnXemLyDo" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination Placeholder (Image 2 style) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <StackPanel.Resources>
                        <Style x:Key="PageBtnStyle" TargetType="Button">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="{StaticResource Gray600}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Gray200}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    <Setter Property="Foreground" Value="#3B82F6"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="{StaticResource Gray400}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="PageNumberButtonStyle" TargetType="Button" BasedOn="{StaticResource PageBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,6"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsActive}" Value="True"/>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#2563EB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                    <Button Content="« Trước" Style="{StaticResource PageBtnStyle}" Command="{Binding PreviousPageCommand}"/>
                    <ItemsControl ItemsSource="{Binding PageNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Number}"
                                        Command="{Binding GoToPageCommand}"
                                        Style="{StaticResource PageNumberButtonStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Sau »" Style="{StaticResource PageBtnStyle}" Command="{Binding NextPageCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- 2) MÀN HÌNH FORM LẬP PHIẾU -->
    <Grid Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <Border Background="#40000000"/>
        <Border Background="White" CornerRadius="20" Margin="40,20" MaxWidth="1200" HorizontalAlignment="Stretch">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Form Header & Info Card -->
                <Grid Grid.Row="0" Margin="28,24,28,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Form Header Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FormTitle}" FontSize="22" FontWeight="Bold" Foreground="#1E293B"
                                       FontFamily="Segoe UI Variable, Segoe UI, Arial"/>
                            <Border CornerRadius="12" Padding="12,5" Margin="16,0,0,0" VerticalAlignment="Center" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1">
                                <TextBlock Text="{Binding FormBadge}" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseFormCommand}" Style="{StaticResource CircularCloseButtonStyle}" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Info Card Row -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="14" Padding="20,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Mã Phiếu -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mã Phiếu" FontSize="12" Foreground="{StaticResource Gray500}" Margin="4,0,0,6" FontWeight="SemiBold"/>
                                    <Border Style="{StaticResource ModernInputBorder}" Background="#F1F5F9" BorderThickness="1">
                                        <TextBox Text="{Binding MaPhieu}" IsReadOnly="True" Style="{StaticResource ModernTextBoxStyle}" Padding="12,10" Background="Transparent"/>
                                    </Border>
                                </StackPanel>

                                <!-- Nhân viên phụ trách -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Nhân viên phụ trách" FontSize="12" Foreground="{StaticResource Gray500}" Margin="4,0,0,6" FontWeight="SemiBold"/>
                                    <Border Style="{StaticResource ModernInputBorder}" Background="#F1F5F9" BorderThickness="1">
                                        <TextBox Text="{Binding TenNhanVienKiem}" IsReadOnly="True" Style="{StaticResource ModernTextBoxStyle}" Padding="12,10" Background="Transparent"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Loại kiểm + Lý do kiểm -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Loại kiểm -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="12" Foreground="{StaticResource Gray500}" Margin="4,0,0,6" FontWeight="SemiBold">
                                        <Run Text="Loại kiểm kê"/>
                                        <Run Text=" *" Foreground="#EF4444"/>
                                    </TextBlock>
                                    <Border Style="{StaticResource ModernInputBorder}" BorderThickness="1">
                                        <ComboBox ItemsSource="{Binding LoaiKiemKeOptions}"
                                                  SelectedItem="{Binding LoaiKiemKe, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource PizzaComboBoxStyle}"
                                                  ItemContainerStyle="{StaticResource PizzaComboBoxItemStyle}"
                                                            BorderThickness="0" Background="Transparent"
                                                  Padding="8,8" VerticalContentAlignment="Center"
                                                  IsEnabled="{Binding IsViewOnly, Converter={StaticResource InverseBoolConverter}}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Lý do kiểm -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Lý do kiểm kê" FontSize="12" Foreground="{StaticResource Gray500}" Margin="4,0,0,6" FontWeight="SemiBold"/>
                                    <Border Style="{StaticResource ModernInputBorder}" BorderThickness="1">
                                        <Grid>
                                            <TextBox x:Name="txtLyDoKiemKe" Text="{Binding LyDoKiemKe, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBoxStyle}" Padding="12,10" Background="Transparent"
                                                     IsEnabled="{Binding IsViewOnly, Converter={StaticResource InverseBoolConverter}}"/>
                                            <TextBlock Text="Nhập lý do kiểm kê..." Style="{StaticResource PlaceholderStyle}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                                                       Visibility="{Binding Text, ElementName=txtLyDoKiemKe, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- Form Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="28,8,28,0">
                    <StackPanel>
                        <!-- Section Header: Danh sách đếm hàng thực tế & Thêm nguyên liệu -->
                        <Grid Margin="0,8,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Danh sách đếm hàng thực tế" FontSize="16" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>

                            <!-- Add row button on the right -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsViewOnly, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Button Command="{Binding AddEmptyChiTietCommand}"
                                        Style="{StaticResource OutlineButton}" BorderBrush="#3B82F6" Foreground="#3B82F6" Height="40" Padding="14,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+ " FontWeight="Bold" FontSize="14" Foreground="#3B82F6"/>
                                        <TextBlock Text="Thêm dòng nguyên liệu" FontWeight="SemiBold" FontSize="13" Foreground="#3B82F6"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Bảng chi tiết kiểm kê -->
                        <DataGrid ItemsSource="{Binding ChiTietKiemKeForm}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserResizeColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="64"
                                  Background="White" BorderThickness="1" BorderBrush="#E2E8F0"
                                  ColumnHeaderHeight="75"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="White"/>
                                     <Setter Property="FontSize" Value="12"/>
                                     <Setter Property="FontWeight" Value="SemiBold"/>
                                     <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
                                     <Setter Property="Padding" Value="8,6"/>
                                     <Setter Property="MinHeight" Value="60"/>
                                     <Setter Property="VerticalContentAlignment" Value="Center"/>
                                     <Setter Property="BorderBrush" Value="#334155"/>
                                     <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                     <Setter Property="SeparatorBrush" Value="Transparent"/>
                                 </Style>
                             </DataGrid.ColumnHeaderStyle>

                             <DataGrid.RowStyle>
                                 <Style TargetType="DataGridRow">
                                     <Setter Property="Background" Value="White"/>
                                     <Setter Property="Foreground" Value="{StaticResource Gray800}"/>
                                     <Setter Property="MinHeight" Value="64"/>
                                     <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                     <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                     <Style.Triggers>
                                         <Trigger Property="IsMouseOver" Value="True">
                                             <Setter Property="Background" Value="#F8FAFC"/>
                                         </Trigger>
                                         <Trigger Property="IsSelected" Value="True">
                                             <Setter Property="Background" Value="White"/>
                                             <Setter Property="Foreground" Value="{StaticResource Gray800}"/>
                                         </Trigger>
                                     </Style.Triggers>
                                 </Style>
                             </DataGrid.RowStyle>

                             <DataGrid.CellStyle>
                                 <Style TargetType="DataGridCell">
                                     <Setter Property="Background" Value="White"/>
                                     <Setter Property="Foreground" Value="{StaticResource Gray800}"/>
                                     <Setter Property="BorderThickness" Value="0"/>
                                     <Setter Property="Padding" Value="0"/>
                                     <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                     <Setter Property="Template">
                                         <Setter.Value>
                                             <ControlTemplate TargetType="DataGridCell">
                                                 <Border Background="{TemplateBinding Background}"
                                                         Padding="{TemplateBinding Padding}">
                                                     <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                 </Border>
                                             </ControlTemplate>
                                         </Setter.Value>
                                     </Setter>
                                     <Style.Triggers>
                                         <Trigger Property="IsSelected" Value="True">
                                             <Setter Property="Background" Value="White"/>
                                             <Setter Property="Foreground" Value="{StaticResource Gray800}"/>
                                         </Trigger>
                                         <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                             <Setter Property="Background" Value="White"/>
                                         </Trigger>
                                     </Style.Triggers>
                                 </Style>
                             </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <!-- Tên Nguyên Liệu -->
                                <DataGridTemplateColumn Width="1.35*">
                                     <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Tên Nguyên Liệu" HorizontalAlignment="Left" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                     </DataGridTemplateColumn.Header>
                                     <DataGridTemplateColumn.CellTemplate>
                                         <DataTemplate>
                                            <StackPanel Margin="5,0" VerticalAlignment="Center">
                                                 <!-- Dropdown box style to match Image 2 -->
                                                <Border BorderBrush="{StaticResource Gray200}" BorderThickness="1.5" CornerRadius="8" Background="White" Padding="0" Height="40">
                                                     <ComboBox ItemsSource="{Binding DataContext.NguyenLieus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               SelectedItem="{Binding NguyenLieu, UpdateSourceTrigger=PropertyChanged}"
                                                               DisplayMemberPath="TenNguyenLieu"
                                                               Style="{StaticResource PizzaComboBoxStyle}"
                                                               ItemContainerStyle="{StaticResource PizzaComboBoxItemStyle}"
                                                               BorderThickness="0" Background="Transparent"
                                                               Padding="6,4" Height="38" VerticalContentAlignment="Center"
                                                               IsEnabled="{Binding DataContext.IsViewOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}"/>
                                                 </Border>
                                                 <!-- Quy đổi hiển thị -->
                                                <TextBlock Text="{Binding QuyDoiDisplay}" Visibility="Collapsed"/>
                                             </StackPanel>
                                         </DataTemplate>
                                     </DataGridTemplateColumn.CellTemplate>
                                 </DataGridTemplateColumn>

                                <!-- HSD (Nhập ngày) -->
                                <DataGridTemplateColumn Width="0.95*">
                                     <DataGridTemplateColumn.Header>
                                         <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="HSD" HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                                            <TextBlock Text="(Nhập ngày hết hạn)" HorizontalAlignment="Center" FontSize="11" Foreground="#94A3B8" FontWeight="Normal"
                                                       TextWrapping="Wrap" TextAlignment="Center"/>
                                         </StackPanel>
                                     </DataGridTemplateColumn.Header>
                                     <DataGridTemplateColumn.CellTemplate>
                                         <DataTemplate>
                                            <Border BorderBrush="{StaticResource Gray200}" BorderThickness="1.5" CornerRadius="8" Background="White" Padding="0" Margin="5,0" Height="40" VerticalAlignment="Center">
                                                <DatePicker SelectedDate="{Binding NgayHetHanNhap, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                            Language="vi-VN"
                                                            BorderThickness="0" Background="Transparent"
                                                             Padding="4,4" Height="38" VerticalContentAlignment="Center" FontSize="12"
                                                             IsEnabled="{Binding DataContext.IsViewOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}"/>
                                             </Border>
                                         </DataTemplate>
                                     </DataGridTemplateColumn.CellTemplate>
                                 </DataGridTemplateColumn>

                                <!-- Lô nguyên liệu -->
                                <DataGridTemplateColumn Width="1.7*" Visibility="Collapsed">
                                     <DataGridTemplateColumn.Header>
                                         <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Lô nguyên liệu" HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                                            <TextBlock Text="(Chọn lô)" HorizontalAlignment="Center" FontSize="11" Foreground="#94A3B8" FontWeight="Normal"
                                                       TextWrapping="Wrap" TextAlignment="Center"/>
                                         </StackPanel>
                                     </DataGridTemplateColumn.Header>
                                     <DataGridTemplateColumn.CellTemplate>
                                         <DataTemplate>
                                            <StackPanel Margin="5,0" VerticalAlignment="Center">
                                                <Border BorderBrush="{StaticResource Gray200}" BorderThickness="1.5" CornerRadius="8" Background="White" Padding="0" Height="40">
                                                     <ComboBox ItemsSource="{Binding LoKiemKeOptions}"
                                                               SelectedItem="{Binding SelectedLoKiemKe, UpdateSourceTrigger=PropertyChanged}"
                                                               DisplayMemberPath="DisplayText"
                                                               Style="{StaticResource PizzaComboBoxStyle}"
                                                               ItemContainerStyle="{StaticResource PizzaComboBoxItemStyle}"
                                                               BorderThickness="0" Background="Transparent"
                                                               Padding="6,4" Height="38" MaxDropDownHeight="280"
                                                               ToolTip="{Binding SelectedLoKiemKe.DisplayText}"
                                                               VerticalContentAlignment="Center"
                                                               IsEnabled="{Binding DataContext.IsViewOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}"/>
                                                 </Border>
                                                 <TextBlock Text="{Binding LoKiemKeDisplay}" Visibility="Collapsed"/>
                                             </StackPanel>
                                         </DataTemplate>
                                     </DataGridTemplateColumn.CellTemplate>
                                 </DataGridTemplateColumn>

                                <!-- Tồn Hệ Thống -->
                                <DataGridTemplateColumn Width="0.75*">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Tồn Hệ Thống" HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                                            <TextBlock Text="(Đơn vị lưu tồn kho)" HorizontalAlignment="Center" FontSize="11" Foreground="#94A3B8" FontWeight="Normal"
                                                       TextWrapping="Wrap" TextAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TonHeThong, StringFormat=\{0:0.##\}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Gray800}"/>
                                                <TextBlock Text=" "/>
                                                <TextBlock Text="{Binding TenDonViKho}" FontSize="13" Foreground="{StaticResource Gray600}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Tồn Thực Tế -->
                                <DataGridTemplateColumn Width="1.15*">
                                     <DataGridTemplateColumn.Header>
                                         <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Tồn Thực Tế" HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                                            <TextBlock Text="(Nhập số đếm)" HorizontalAlignment="Center" FontSize="11" Foreground="#94A3B8" FontWeight="Normal"
                                                       TextWrapping="Wrap" TextAlignment="Center"/>
                                         </StackPanel>
                                     </DataGridTemplateColumn.Header>
                                     <DataGridTemplateColumn.CellTemplate>
                                         <DataTemplate>
                                            <Grid Margin="5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="72"/>
                                                 </Grid.ColumnDefinitions>
                                                 <!-- TextBox for numeric input -->
                                                <Border Grid.Column="0" Style="{StaticResource ModernInputBorder}" Padding="0" Height="38">
                                                     <TextBox Style="{StaticResource BorderlessTextBoxStyle}" Text="{Binding TonThucTeText, UpdateSourceTrigger=PropertyChanged}"
                                                              BorderThickness="0" Background="Transparent"
                                                              FontSize="13" FontWeight="Bold" Foreground="{StaticResource Gray800}"
                                                             TextAlignment="Center" VerticalContentAlignment="Center"
                                                             IsEnabled="{Binding DataContext.IsViewOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}"/>
                                                 </Border>
                                                 <!-- ComboBox for unit selection -->
                                                <Border Grid.Column="2" Style="{StaticResource ModernInputBorder}" Padding="0" Height="38">
                                                     <ComboBox ItemsSource="{Binding DonViKiemOptions}"
                                                               SelectedItem="{Binding SelectedDonViKiem, UpdateSourceTrigger=PropertyChanged}"
                                                               DisplayMemberPath="DonViTinh.TenDonVi"
                                                              Style="{StaticResource BlueComboBoxStyle}"
                                                              ItemContainerStyle="{StaticResource PizzaComboBoxItemStyle}"
                                                              BorderThickness="0" Background="Transparent"
                                                              IsEnabled="{Binding DataContext.IsViewOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Chênh Lệch -->
                                <DataGridTemplateColumn Width="1.05*">
                                     <DataGridTemplateColumn.Header>
                                         <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Chênh Lệch" HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                                            <TextBlock Text="(Hệ thống &amp; Thực tế)" HorizontalAlignment="Center" FontSize="11" Foreground="#94A3B8" FontWeight="Normal"
                                                       TextWrapping="Wrap" TextAlignment="Center"/>
                                         </StackPanel>
                                     </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding ChenhLechDisplay}" FontWeight="Bold" FontSize="13" Foreground="{Binding ChenhLechColor}"/>
                                                    <TextBlock Text=" "/>
                                                    <TextBlock Text="{Binding TenDonViKho}" FontWeight="Bold" FontSize="13" Foreground="{Binding ChenhLechColor}"/>
                                                </StackPanel>
                                                <Border CornerRadius="6" Padding="7,2" Margin="8,0,0,0" HorizontalAlignment="Center" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ChenhLechLabel}" Value="Tăng">
                                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                                    <Setter Property="BorderBrush" Value="#81C784"/>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ChenhLechLabel}" Value="Hao hụt">
                                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                                    <Setter Property="BorderBrush" Value="#E57373"/>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding ChenhLechLabel}" FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ChenhLechLabel}" Value="Tăng">
                                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ChenhLechLabel}" Value="Hao hụt">
                                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Lý do / Giải trình -->
                                <DataGridTemplateColumn Width="0.85*" MinWidth="40">
                                     <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Lý do / Giải trình" HorizontalAlignment="Left" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                     </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ModernInputBorder}" Margin="4,4" VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBox x:Name="txtGhiChu" Text="{Binding GhiChuNhanVien, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource ModernTextBoxStyle}" Padding="10,6" BorderThickness="0" Background="Transparent" FontSize="13"
                                                             IsEnabled="{Binding DataContext.IsViewOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}"/>
                                                    <TextBlock Text="Nhập ghi chú..." Style="{StaticResource PlaceholderStyle}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0"
                                                               Visibility="{Binding Text, ElementName=txtGhiChu, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Xóa -->
                                <DataGridTemplateColumn Width="0.3*" MinWidth="36">
                                     <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Xóa" HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                     </DataGridTemplateColumn.Header>
                                     <DataGridTemplateColumn.CellTemplate>
                                         <DataTemplate>
                                             <Button Command="{Binding DataContext.RemoveNguyenLieuCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                     CommandParameter="{Binding}" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     ToolTip="Xóa dòng"
                                                     Width="36" Height="36"
                                                     Visibility="{Binding DataContext.IsViewOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                 <Button.Template>
                                                     <ControlTemplate TargetType="Button">
                                                         <Border x:Name="border" CornerRadius="8" Background="Transparent">
                                                             <ui:SymbolIcon Symbol="Delete24" FontSize="15" Foreground="#EF4444"
                                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                          </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Form Footer -->
                <Border Grid.Row="2" Padding="28,16,28,24" BorderThickness="0,1,0,0" BorderBrush="#F1F5F9">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseFormCommand}" Padding="24,12" Margin="0,0,12,0" Cursor="Hand"
                                Background="#F1F5F9" Foreground="#475569" BorderBrush="#E2E8F0" BorderThickness="1" FontWeight="SemiBold" FontSize="14">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            Thoát
                        </Button>
                        <Button Command="{Binding SaveDraftCommand}" Padding="24,12" Margin="0,0,12,0" Cursor="Hand"
                                Background="#475569" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="14">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            Lưu Bản Nháp
                        </Button>
                        <Button Command="{Binding SubmitCommand}" Padding="24,12" Cursor="Hand"
                                Background="#0284C7" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="14">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            Hoàn Tất &amp; Gửi Quản Lý Duyệt
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <!-- 3) MÀN HÌNH CHI TIẾT PHIẾU (FULL PAGE) -->
    <Grid Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" Background="{StaticResource SoftWhiteBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,32">

                <!-- Breadcrumb -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Foreground="#3B82F6" Cursor="Hand" FontSize="13">
                        <Hyperlink Command="{Binding BackToListCommand}" Foreground="#3B82F6" TextDecorations="None">
                            <Run Text="Danh sách phiếu kiểm kê"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text=" > " Foreground="#94A3B8" FontSize="13" Margin="4,0"/>
                    <TextBlock FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Xem chi tiết chứng từ"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReviewMode}" Value="True">
                                        <Setter Property="Text" Value="Đối soát chi tiết"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Title + Badge -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" FontFamily="Segoe UI Variable, Segoe UI, Arial">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="CHI TIẾT PHIẾU KIỂM KÊ"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReviewMode}" Value="True">
                                            <Setter Property="Text" Value="ĐỐI SOÁT CHI TIẾT PHIẾU KIỂM KÊ"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Mã phiếu: " FontSize="13" Foreground="#64748B"/>
                            <TextBlock Text="{Binding MaPhieu}" FontSize="13" Foreground="#1E293B" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Trạng thái Badge -->
                    <Border Grid.Column="1" CornerRadius="14" Padding="20,8" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FormBadge}" Value="Đã Duyệt">
                                        <Setter Property="Background" Value="#D1FAE5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FormBadge}" Value="Đã Hủy">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FormBadge}" Value="Chờ Duyệt">
                                        <Setter Property="Background" Value="#FEF3C7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="13" FontWeight="Bold" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding FormBadge}"/>
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FormBadge}" Value="Đã Duyệt">
                                            <Setter Property="Foreground" Value="#059669"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FormBadge}" Value="Đã Hủy">
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FormBadge}" Value="Chờ Duyệt">
                                            <Setter Property="Text" Value="Đang Chờ Duyệt"/>
                                            <Setter Property="Foreground" Value="#D97706"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- Review Mode Info Card (Chỉ hiện khi IsReviewMode) -->
                <Border Margin="0,16,0,0" Background="#F1F5F9" CornerRadius="8" Padding="24,16"
                        Visibility="{Binding IsReviewMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="3" Background="#64748B" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NHÂN VIÊN THỰC HIỆN" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TenNhanVienKiem}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </StackPanel>

                        <Border Width="3" Background="#64748B" Margin="60,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="THỜI GIAN CHỐT ĐẾM" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding NgayKiemDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </StackPanel>

                        <Border Width="3" Background="#64748B" Margin="60,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LOẠI KIỂM KÊ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding LoaiKiemKe, Converter={StaticResource NullOrEmptyToTextConverter}}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Hai card thông tin (Chỉ hiện khi không phải Review Mode) -->
                <Grid Margin="0,16,0,0" Visibility="{Binding IsReviewMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card: Thông tin lập phiếu -->
                    <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="24,20" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="THÔNG TIN LẬP PHIẾU" FontSize="12" FontWeight="Bold" Foreground="#64748B"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nhân viên đếm:" FontSize="13" Foreground="#64748B" Margin="0,0,16,10"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TenNhanVienKiem}" FontSize="13" Foreground="#1E293B" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Thời gian chốt đếm:" FontSize="13" Foreground="#64748B" Margin="0,0,16,10"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NgayKiemDisplay}" FontSize="13" Foreground="#1E293B" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Loại kiểm kê:" FontSize="13" Foreground="#64748B" Margin="0,0,16,10"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LoaiKiemKe, Converter={StaticResource NullOrEmptyToTextConverter}}" FontSize="13" Foreground="#1E293B" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Lý do kiểm kê:" FontSize="13" Foreground="#64748B" Margin="0,0,16,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LyDoKiemKe, Converter={StaticResource NullOrEmptyToTextConverter}}" FontSize="13" Foreground="#1E293B" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card: Thông tin phê duyệt (Đã Duyệt) -->
                    <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="24,20" BorderBrush="#E2E8F0" BorderThickness="1"
                            Visibility="{Binding IsDaDuyet, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="THÔNG TIN PHÊ DUYỆT" FontSize="12" FontWeight="Bold" Foreground="#64748B"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Quản lý chốt sổ:" FontSize="13" Foreground="#64748B" Margin="0,0,16,10"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TenNhanVienDuyet}" FontSize="13" Foreground="#1E293B" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Thời gian duyệt:" FontSize="13" Foreground="#64748B" Margin="0,0,16,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NgayDuyetDisplay}" FontSize="13" Foreground="#1E293B" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card: Thông tin từ chối (Đã Hủy) -->
                    <Border Grid.Column="2" Background="#FFF5F5" CornerRadius="14" Padding="24,20" BorderBrush="#FECACA" BorderThickness="1"
                            Visibility="{Binding IsDaHuy, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="THÔNG TIN TỪ CHỐI" FontSize="12" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Quản lý hủy phiếu:" FontSize="13" Foreground="#64748B" Margin="0,0,16,10"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TenNhanVienDuyet}" FontSize="13" Foreground="#1E293B" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Thời gian thao tác:" FontSize="13" Foreground="#64748B" Margin="0,0,16,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NgayDuyetDisplay}" FontSize="13" Foreground="#1E293B" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <!-- Lý do từ chối -->
                            <Border Margin="0,14,0,0" Background="#FFF0F0" CornerRadius="10" Padding="16,12" BorderBrush="#FECACA" BorderThickness="1">
                                <TextBlock Foreground="#991B1B" FontSize="13" TextWrapping="Wrap" FontStyle="Italic">
                                    <Run Text="Lý do: " FontWeight="SemiBold" FontStyle="Normal"/>
                                    <Run Text="{Binding GhiChuDuyet, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Banner cảnh báo phiếu bị hủy -->
                <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="12" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                        Visibility="{Binding IsDaHuy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info24" FontSize="18" Foreground="#2563EB" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <TextBlock FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap">
                            <Run Text="Chứng từ vô hiệu lực:" FontWeight="Bold"/>
                            <Run Text=" Tờ phiếu này đã bị quản lý từ chối và hủy bỏ. Hệ thống "/>
                            <Run Text="không ghi nhận" FontWeight="Bold"/>
                            <Run Text=" bất kỳ biến động hay chênh lệch Tồn kho nào từ các số liệu bên dưới. Dữ liệu chỉ được giữ lại để lưu vết kiểm toán."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- BẢNG CHI TIẾT SỐ LIỆU -->
                <StackPanel Margin="0,20,0,0">
                    <Grid Margin="0,0,0,10">
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#1E293B">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="BẢNG CHI TIẾT SỐ LIỆU"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReviewMode}" Value="True">
                                            <Setter Property="Text" Value="BẢNG PHÂN TÍCH CHÊNH LỆCH SỐ LIỆU"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDaHuy}" Value="True">
                                            <Setter Property="Text" Value="SỐ LIỆU ĐÃ BỊ TỪ CHỐI"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Chỉ đọc badge -->
                        <Border HorizontalAlignment="Right" CornerRadius="8" Padding="10,5" Background="#F1F5F9"
                                Visibility="{Binding IsReviewMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock FontSize="11" Foreground="#6B7280">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDaDuyet}" Value="True">
                                                <Setter Property="Text" Value="Chỉ đọc (Dữ liệu đã khóa)"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDaHuy}" Value="True">
                                                <Setter Property="Text" Value="Chỉ đọc"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <Border Background="White" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding ChiTietKiemKeForm}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserResizeColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="68"
                                  Background="White" BorderThickness="0" ColumnHeaderHeight="75"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="MinHeight" Value="60"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsDaHuy, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Background" Value="#64748B"/>
                                            <Setter Property="BorderBrush" Value="#94A3B8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                             </DataGrid.ColumnHeaderStyle>
                             <DataGrid.RowStyle>
                                 <Style TargetType="DataGridRow">
                                     <Setter Property="Background" Value="White"/>
                                     <Setter Property="Foreground" Value="{StaticResource Gray800}"/>
                                     <Setter Property="MinHeight" Value="68"/>
                                     <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                     <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                     <Style.Triggers>
                                         <Trigger Property="IsMouseOver" Value="True">
                                             <Setter Property="Background" Value="#F8FAFC"/>
                                         </Trigger>
                                         <Trigger Property="IsSelected" Value="True">
                                             <Setter Property="Background" Value="White"/>
                                             <Setter Property="Foreground" Value="{StaticResource Gray800}"/>
                                         </Trigger>
                                     </Style.Triggers>
                                 </Style>
                             </DataGrid.RowStyle>
                             <DataGrid.CellStyle>
                                 <Style TargetType="DataGridCell">
                                     <Setter Property="Background" Value="White"/>
                                     <Setter Property="Foreground" Value="{StaticResource Gray800}"/>
                                     <Setter Property="BorderThickness" Value="0"/>
                                     <Setter Property="Padding" Value="0"/>
                                     <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                     <Setter Property="Template">
                                         <Setter.Value>
                                             <ControlTemplate TargetType="DataGridCell">
                                                 <Border Background="{TemplateBinding Background}"
                                                         Padding="{TemplateBinding Padding}">
                                                     <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                 </Border>
                                             </ControlTemplate>
                                         </Setter.Value>
                                     </Setter>
                                     <Style.Triggers>
                                         <Trigger Property="IsSelected" Value="True">
                                             <Setter Property="Background" Value="White"/>
                                             <Setter Property="Foreground" Value="{StaticResource Gray800}"/>
                                         </Trigger>
                                     </Style.Triggers>
                                 </Style>
                             </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <!-- Nguyên Liệu -->
                                <DataGridTemplateColumn Header="Nguyên Liệu" Width="1.35*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NguyenLieu.TenNguyenLieu}" FontSize="13" FontWeight="Medium" Foreground="#1E293B"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Visibility="Collapsed">
                                                    <Run Text="("/>
                                                    <Run Text="{Binding QuyDoiDisplay, Mode=OneWay}"/>
                                                    <Run Text=")"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Lô / HSD -->
                                <DataGridTemplateColumn Header="Lô / HSD" Width="1.25*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MaPhieuNhap, Converter={StaticResource NullOrEmptyToTextConverter}}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding HSDText}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Tồn Hệ Thống -->
                                <DataGridTemplateColumn Header="Tồn Hệ Thống&#x0a;(ĐVT lưu tồn kho)" Width="0.8*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13">
                                                <Run Text="{Binding TonHeThong, StringFormat=\{0:0.##\}, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding TenDonViKho, Mode=OneWay}" Foreground="#64748B"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Tồn Thực Tế -->
                                <DataGridTemplateColumn Width="0.95*">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Tồn Thực Tế&#x0a;(ĐVT Nhân viên đếm)"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsDaHuy, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                                <Setter Property="Text" Value="Tồn Thực Tế&#x0a;(Bị hủy)"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#3B82F6">
                                                <Run Text="{Binding TonThucTe, StringFormat=\{0:0.##\}, Mode=OneWay}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding TenDonViKiem, Mode=OneWay}" Foreground="#64748B" FontWeight="Normal"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Chênh Lệch Quy Đổi -->
                                <DataGridTemplateColumn Header="Chênh Lệch Quy Đổi&#x0a;(Tính theo hệ thống)" Width="1.05*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontWeight="Bold" FontSize="13">
                                                        <TextBlock.Text>
                                                            <Binding Path="ChenhLechDisplay"/>
                                                        </TextBlock.Text>
                                                        <TextBlock.Foreground>
                                                            <Binding Path="ChenhLechColor"/>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                    <TextBlock Text=" "/>
                                                    <TextBlock Text="{Binding TenDonViKho}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border CornerRadius="8" Padding="8,2" Margin="0,3,0,0" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ChenhLechLabel}" Value="Tăng">
                                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ChenhLechLabel}" Value="Hao hụt">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding ChenhLechPercent}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                        <TextBlock.Foreground>
                                                            <Binding Path="ChenhLechColor"/>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Lý Do / Giải Trình -->
                                <DataGridTemplateColumn Width="1.2*" MinWidth="40">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Lý Do / Giải Trình"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsDaHuy, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                                <Setter Property="Text" Value="Lý Do / Giải Trình Ban Đầu"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding GhiChuNhanVien, Converter={StaticResource StringTruncateConverter}}"
                                                       FontSize="12" FontStyle="Italic"
                                                       Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Margin="12,8"
                                                       ToolTip="{Binding GhiChuNhanVien}" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>

                <!-- Footer cho review mode -->
                <Grid Margin="0,20,0,0" Visibility="{Binding IsReviewMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding OpenRejectDialogCommand}" Padding="24,12" Cursor="Hand" BorderThickness="0" FontSize="14">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="6" Padding="{TemplateBinding Padding}" Cursor="Hand" Background="#EF4444">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Từ chối phiếu" FontWeight="SemiBold" Foreground="White"/>
                    </Button>

                    <Button Grid.Column="2" Command="{Binding OpenApproveDialogCommand}" Padding="24,12" Cursor="Hand" BorderThickness="0" FontSize="14">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="6" Padding="{TemplateBinding Padding}" Cursor="Hand" Background="#10B981">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Đồng Ý Duyệt &amp; Cập Nhật Kho" FontWeight="SemiBold" Foreground="White"/>
                    </Button>
                </Grid>

                <!-- Footer cho view-only (không review) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"
                            Visibility="{Binding IsReviewMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Button Command="{Binding PrintCommand}" CommandParameter="{Binding CurrentPhieu}" Padding="20,12" Margin="0,0,12,0"
                            Background="{StaticResource Gray100}" BorderThickness="1" BorderBrush="{StaticResource Gray300}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Gray700}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="In phiếu" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Gray700}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource Gray200}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Command="{Binding BackToListCommand}" Padding="20,12"
                            Style="{StaticResource PrimaryButtonStyle}" FontSize="14">
                        <TextBlock Text="Quay Lại Danh Sách" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <!-- 4) DIALOG XÁC NHẬN TỪ CHỐI -->
    <Grid Visibility="{Binding IsRejectDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}" Background="#80000000">
        <Border Background="White" CornerRadius="20" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.15"/>
            </Border.Effect>
            <StackPanel>
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="32" Height="32" CornerRadius="16" Background="#FEE2E2" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="18" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Xác nhận Từ chối &amp; Hủy phiếu" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Vui lòng nhập lý do từ chối để nhân viên kho nắm được thông tin. Tờ phiếu này sẽ bị đóng băng và vô hiệu hóa."
                           FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <!-- Textarea -->
                <Border Background="White" BorderBrush="#FECACA" BorderThickness="1.5" CornerRadius="10" Padding="12,10">
                    <TextBox Text="{Binding LyDoTuChoi, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent" FontSize="13"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                             VerticalScrollBarVisibility="Auto">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Tag" Value="Nhập lý do từ chối"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Command="{Binding CloseRejectDialogCommand}" Padding="24,12" Margin="0,0,12,0" Cursor="Hand"
                            Background="White" BorderThickness="1" FontSize="14">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="White" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                        BorderBrush="#D1D5DB" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Quay lại" FontWeight="SemiBold" Foreground="#374151"/>
                    </Button>
                    <Button Command="{Binding ConfirmRejectCommand}" Padding="24,12" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="10" Padding="{TemplateBinding Padding}" Background="#DC2626" Cursor="Hand">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Xác nhận Hủy phiếu" FontWeight="SemiBold" Foreground="White"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- 4B) DIALOG XÁC NHẬN YÊU CẦU ĐẾM LẠI -->
    <Grid Visibility="{Binding IsRecountDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}" Background="#80000000">
        <Border Background="White" CornerRadius="20" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.15"/>
            </Border.Effect>
            <StackPanel>
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="32" Height="32" CornerRadius="16" Background="#FFF3E0" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Yêu cầu Đếm lại Phiếu" FontSize="18" FontWeight="Bold" Foreground="#E65100" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Vui lòng nhập nội dung chỉ đạo / lý do yêu cầu đếm lại để nhân viên kho thực hiện đếm lại. Phiếu này sẽ quay về trạng thái Nháp."
                           FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <!-- Textarea -->
                <Border Background="White" BorderBrush="#FFE0B2" BorderThickness="1.5" CornerRadius="10" Padding="12,10">
                    <TextBox Text="{Binding LyDoRecount, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent" FontSize="13"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                             VerticalScrollBarVisibility="Auto">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Tag" Value="Nhập lý do yêu cầu đếm lại..."/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Command="{Binding CloseRecountDialogCommand}" Padding="24,12" Margin="0,0,12,0" Cursor="Hand"
                            Background="White" BorderThickness="1" FontSize="14">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="White" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                        BorderBrush="#D1D5DB" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Quay lại" FontWeight="SemiBold" Foreground="#374151"/>
                    </Button>
                    <Button Command="{Binding ConfirmRecountCommand}" Padding="24,12" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="10" Padding="{TemplateBinding Padding}" Background="#E65100" Cursor="Hand">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Xác nhận Đếm lại" FontWeight="SemiBold" Foreground="White"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- 5) DIALOG XÁC NHẬN DUYỆT -->
    <Grid Visibility="{Binding IsApproveDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}" Background="#80000000">
        <Border Background="White" CornerRadius="20" Width="580" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.15"/>
            </Border.Effect>
            <StackPanel>
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="32" Height="32" CornerRadius="16" Background="#D1FAE5" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="18" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Xác nhận Duyệt Phiếu Kiểm Kê" FontSize="18" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#374151" Margin="0,0,0,16">
                    <Run Text="Bạn đang xác nhận duyệt phiếu kiểm kê "/>
                    <Run Text="{Binding MaPhieu, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=". Tờ phiếu này sẽ bị khóa và hệ thống sẽ tự động cập nhật số liệu vào thẻ kho."/>
                </TextBlock>

                <!-- Preview sinh chứng từ -->
                <Border Background="#F0FDF4" CornerRadius="12" Padding="16,14" BorderBrush="#BBF7D0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="DỰ KIẾN SINH CHỨNG TỪ TỰ ĐỘNG:" FontSize="11" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding ApprovePreviewItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="•" FontSize="14" Foreground="#166534" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                        <TextBlock FontSize="13" Foreground="#1E293B" TextWrapping="Wrap">
                                            <Run Text="{Binding Description, Mode=OneWay}"/>
                                            <Run Text="{Binding HighlightText, Mode=OneWay}" FontWeight="Bold" Foreground="{Binding HighlightColor, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Command="{Binding CloseApproveDialogCommand}" Padding="24,12" Margin="0,0,12,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="White" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                        BorderBrush="#D1D5DB" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Xem lại phiếu" FontWeight="SemiBold" Foreground="#374151"/>
                    </Button>
                    <Button Command="{Binding ConfirmApproveCommand}" Padding="24,12"
                            Style="{StaticResource SuccessButtonStyle}" FontSize="14" Cursor="Hand">
                        <TextBlock Text="Xác nhận Duyệt" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Loading overlay -->
    <!-- Loading Overlay -->
        <!-- Loading Overlay -->
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Panel.ZIndex="999">
            <Border Background="Transparent" />
            <components:LoadingSpinner HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
</Grid>
</UserControl>
